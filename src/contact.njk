---
layout: layouts/default.njk
navbar: navbar1
footer: footer1
colorModifier: dark
translationKey: contact
pagination:
  data: i18n.config.supportedLangs
  size: 1
  alias: language
permalink: "{{ i18n.config.pages.contact[language] }}"
eleventyComputed:
  title: "{{ i18n[language].pages.contact.title }}"
  description: "{{ i18n[language].pages.contact.description }}"
---
<div class="container">
  <div class="row d-flex justify-content-center">
    <div class="site-page-heading col-12 text-center">
      <h1>{{title}}</h1>
    </div>
    <div class="col-11 col-lg-10 col-xl-6 border-bottom border-top py-vh-3">
      <div class="contact-form">

        <form method="post" action="https://formspree.io/f/xrgrjbwo" id="contact-form">

          <div class="contact-form__item">
            <label class="contact-form__label" for="contact-email">{{ i18n | t(language, "pages.contact.email") }} *</label>
            <input id="contact-email" type="email" name="email" placeholder="{{ i18n | t(language, 'pages.contact.emailPlaceholder') }}" class="contact-form__input" autocomplete="email" inputmode="email" required>
          </div>

          <div class="contact-form__item">
            <label class="contact-form__label" for="contact-name">{{ i18n | t(language, "pages.contact.name") }} *</label>
            <input id="contact-name" type="text" name="name" placeholder="{{ i18n | t(language, 'pages.contact.namePlaceholder') }}" class="contact-form__input" autocomplete="name" required>
          </div>

          <div class="contact-form__item">
            <label class="contact-form__label" for="contact-message">{{ i18n | t(language, "pages.contact.message") }} *</label>
            <textarea id="contact-message" name="message" placeholder="{{ i18n | t(language, 'pages.contact.messagePlaceholder') }}" class="contact-form__textarea" required></textarea>
          </div>
          <div class="contact-form__verification" data-contact-challenge data-sitekey="0x4AAAAAAAAudwxAIPEUguw8"></div>
          <p class="contact-form__status small" role="status" aria-live="polite" tabindex="-1" data-state=""></p>
          <button class="button border-color-white" type="button" data-contact-retry hidden>{{ i18n | t(language, 'pages.contact.retryVerification') }}</button>
          <noscript><p>{{ i18n | t(language, 'pages.contact.javascriptRequired') }}</p></noscript>

          <input type="hidden" name="_subject" value="{{ i18n | t(language, 'pages.contact.subject') }}" />

          <div class="contact-form__item contact-form__submit">
            <button type="submit" class="button button--large border-color-white" disabled>{{ i18n | t(language, 'pages.contact.submit') }}</button>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>
<script id="contact-copy" type="application/json">{{ i18n[language].pages.contact | dump | safe }}</script>
<script type="module" data-cfasync="false" src="/js/contact-form.js?v={{ assets.version }}"></script>
