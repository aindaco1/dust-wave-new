---
layout: layouts/default.njk
footer: footer1
isHomepage: true
translationKey: home
pagination:
  data: i18n.config.supportedLangs
  size: 1
  alias: language
permalink: "{{ i18n.config.pages.home[language] }}"
eleventyComputed:
  title: "{{ i18n[language].pages.home.title }}"
  description: "{{ i18n[language].pages.home.description }}"
---
{# Representative h-card for Bridgy Fed / IndieWeb discovery #}
<div class="h-card visually-hidden">
  <a class="p-name u-url" href="https://dustwave.xyz/">Dust Wave</a>
  <p class="p-note">We make cool stuff.</p>
  <img
    class="u-photo"
    src="https://dustwave.xyz/img/favicon/favicon.png"
    width="96"
    height="96"
    loading="lazy"
    decoding="async"
    alt="Dust Wave logo">
</div>

<div class="home-hero-section w-100 overflow-hidden position-relative" id="top">
  {% include "snippets/hero2.njk" %}
</div>
<div class="container home-projects">
  {% set posts = collections.posts | reverse | head(6) %}
  <div class="row d-flex justify-content-center">
    <div class="col-11 col-lg-10 col-xl-6">
      <div class="row border-bottom">
        {% include "snippets/loop.njk" %}
      </div>
      <div class="home-projects-more row">
        <a class="link-fancy" style="text-align:center;" href="{{ i18n | localizedUrl(language, 'projects', '/projects.html') }}">{{ i18n | t(language, "pages.home.more") }}</a>
      </div>
    </div>
  </div>
</div>
