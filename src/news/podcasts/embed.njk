---
layout: false
pagination:
  data: podcastEpisodePublications
  size: 1
  alias: episode
permalink: "news/podcasts/{{ episode.showSlug }}/{{ episode.slug }}/embed/index.html"
eleventyExcludeFromCollections: true
sitemap:
  ignore: true
---
{% set show = podcastShows | podcastShowBySlug(episode.showSlug) %}
{% set isPremiumTeaser = episode.pageMode == "premium_teaser" %}
{% set embedLanguage = show.language if show and show.language else "en" %}
{% set subscribePath = "/es" + episode.subscribeUrl if embedLanguage == "es" else episode.subscribeUrl %}
<!doctype html>
<html lang="{{ embedLanguage }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="referrer" content="no-referrer">
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'none'; {% if not isPremiumTeaser %}script-src 'self'; {% endif %}style-src 'self' 'unsafe-inline'; img-src 'self' data:; {% if not isPremiumTeaser %}media-src https://media.dustwave.xyz {{ podcastApi.apiOrigin }}; connect-src 'self' https://media.dustwave.xyz {{ podcastApi.apiOrigin }}; {% endif %}font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'">
  <title>{{ episode.title }} · {{ show.title if show else (i18n | t(embedLanguage, "podcast.brand")) }}</title>
  <link rel="canonical" href="{{ metadata.url }}/news/podcasts/{{ episode.showSlug }}/{{ episode.slug }}/">
  <link rel="stylesheet" href="/css/podcast-embed{% if environment == 'production' %}.min{% endif %}.css?v={{ assets.version | default('dev') }}">
</head>
<body>
  <main class="podcast-embed">
    <header class="podcast-embed__header">
      <p>{{ show.title if show else (i18n | t(embedLanguage, "podcast.brand")) }}</p>
      <h1>{{ episode.title }}</h1>
    </header>

    {% if isPremiumTeaser %}
    <section class="podcast-embed__premium" aria-labelledby="podcast-embed-premium-title">
      <p>{{ i18n | t(embedLanguage, "podcast.episode.subscribersOnly") }}</p>
      <h2 id="podcast-embed-premium-title">
        {{ i18n | t(embedLanguage, "podcast.episode.premiumTitle") }}
      </h2>
      <a href="{{ subscribePath }}" target="_blank" rel="noopener noreferrer">
        {{ i18n | t(embedLanguage, "podcast.episode.premiumCta") }}
      </a>
    </section>
    {% else %}
      {% set playerId = "embed_" + episode.showSlug + "_" + episode.slug %}
      {% set title = episode.title %}
      {% set audioUrl = episode.audioUrl %}
      {% set downloadUrl = episode.downloadUrl or episode.audioUrl %}
      {% set artworkUrl = show.artwork if show else null %}
      {% set artworkAlt = i18n | t(embedLanguage, "podcast.artworkAlt", { title: (show.title if show else episode.title) }) %}
      {% set peaksUrl = episode.peaksUrl %}
      {% set playerLanguage = embedLanguage %}
      {% set analyticsEndpoint = podcastApi.apiOrigin + "/v1/analytics/player-events" %}
      {% set analyticsEpisodeId = episode.id %}
      {% include "snippets/audio-player.njk" %}
    {% endif %}

    <a
      class="podcast-embed__episode-link"
      href="/news/podcasts/{{ episode.showSlug }}/{{ episode.slug }}/"
      target="_blank"
      rel="noopener noreferrer">{{ i18n | t(embedLanguage, "podcast.episode.notesOnDustWave") }}</a>
  </main>
  {% if not isPremiumTeaser %}<script src="/js/audio-player.js?v={{ assets.version | default('dev') }}" defer></script>{% endif %}
</body>
</html>
