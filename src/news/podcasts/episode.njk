---
layout: layouts/new.njk
bodyModifier: podcast-episode-page
tags:
  - news
  - podcast
pagination:
  data: podcastEpisodePublications
  size: 1
  alias: episode
permalink: "news/podcasts/{{ episode.showSlug }}/{{ episode.slug }}/index.html"
eleventyComputed:
  title: "{{ episode.title }}"
  summary: "{{ episode.summary }}"
  date: "{{ episode.publicAt }}"
  description: "{{ episode.summary }}"
  og_image: "/img/podcasts/{{ episode.showSlug }}/{{ episode.slug }}/social-card.png"
  og_image_width: 1200
  og_image_height: 630
  og_alt: "{{ episode.title }} · Dust Wave Podcasts"
---

{% set show = podcastShows | podcastShowBySlug(episode.showSlug) %}
{% set isPremiumTeaser = episode.pageMode == "premium_teaser" %}
<article class="podcast-episode h-entry">
  <div class="container py-vh-3">
    <p class="podcast-show__eyebrow">
      {% if isPremiumTeaser %}
      Episodio premium · Premium episode
      {% else %}
      Un episodio de Dust Wave Podcasts
      {% endif %}
    </p>
    <h1 class="p-name">{{ episode.title }}</h1>
    {% if show %}
    <p><a href="/podcasts/{{ show.slug }}/">{{ show.title }}</a></p>
    {% endif %}
    <p class="p-summary">{{ episode.summary }}</p>
    <time class="dt-published" datetime="{{ episode.publicAt }}">{{ episode.publicAt | readablePodcastDate }}</time>

    {% if not isPremiumTeaser %}
    {% set playerId = episode.showSlug + "_" + episode.slug %}
    {% set title = episode.title %}
    {% set audioUrl = episode.audioUrl %}
    {% set downloadUrl = episode.downloadUrl or episode.audioUrl %}
    {% set artworkUrl = show.artwork if show else null %}
    {% set artworkAlt = "Portada de " + (show.title if show else episode.title) %}
    {% set peaksUrl = episode.peaksUrl %}
    {% set playerLanguage = show.language if show else "es" %}
    {% include "snippets/audio-player.njk" %}
    {% endif %}

    <div class="e-content">
      {% if isPremiumTeaser %}
      <section class="podcast-premium-teaser" aria-labelledby="podcast-premium-teaser-title">
        <p class="podcast-premium-teaser__label">Solo para suscriptores · Subscribers only</p>
        <h2 id="podcast-premium-teaser-title">Escucha este episodio con Podcast Premium</h2>
        <p>
          Este episodio extra está disponible en el feed privado del podcast.
          Suscríbete para escuchar sin anuncios, recibir acceso anticipado y
          desbloquear episodios extra.
        </p>
        <p lang="en">
          This bonus episode is available in the podcast’s private feed.
          Subscribe for ad-free listening, early access, and bonus episodes.
        </p>
        <a
          class="btn btn-dark podcast-premium-teaser__cta"
          href="{{ episode.subscribeUrl }}">
          Ver Podcast Premium · Explore Podcast Premium
        </a>
      </section>
      {% else %}
      <h2>Notas del episodio</h2>
      <p>{{ episode.summary }}</p>
      {% set chapterUrl = episode.chapterUrl or ("https://feeds.dustwave.xyz/v1/shows/" + episode.showSlug + "/episodes/" + episode.slug + "/chapters.json") %}
      <section
        class="podcast-chapters"
        data-podcast-chapters
        data-endpoint="{{ chapterUrl }}"
        data-player-id="{{ playerId }}"
        data-language="{{ playerLanguage }}"
        aria-labelledby="podcast-chapters-heading">
        <h2 id="podcast-chapters-heading">Capítulos / Chapters</h2>
        <p
          class="podcast-chapters__status"
          data-podcast-chapters-status
          aria-live="polite">
          Los capítulos aprobados aparecerán aquí. / Approved chapters will appear here.
        </p>
        <div
          class="podcast-chapters__content"
          data-podcast-chapters-content
          hidden></div>
      </section>
      {% set transcriptUrl = episode.transcriptUrl or ("https://feeds.dustwave.xyz/v1/shows/" + episode.showSlug + "/episodes/" + episode.slug + "/transcripts") %}
      <section
        class="podcast-transcript"
        data-podcast-transcript
        data-endpoint="{{ transcriptUrl }}"
        data-player-id="{{ playerId }}"
        data-language="{{ playerLanguage }}"
        aria-labelledby="podcast-transcript-heading">
        <h2 id="podcast-transcript-heading">Transcripción / Transcript</h2>
        <p
          class="podcast-transcript__status"
          data-podcast-transcript-status
          aria-live="polite">
          Las transcripciones aprobadas aparecerán aquí. / Approved transcripts will appear here.
        </p>
        <div
          class="podcast-transcript__content"
          data-podcast-transcript-content
          hidden></div>
      </section>
      {% endif %}
    </div>
  </div>
</article>

{% if not isPremiumTeaser %}
<script src="/js/podcast-chapters.js" defer></script>
<script src="/js/podcast-transcript.js" defer></script>
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  "name": {{ episode.title | safeJsonLd | safe }},
  "description": {{ episode.summary | safeJsonLd | safe }},
  "datePublished": {{ episode.publicAt | safeJsonLd | safe }},
  "url": {{ (metadata.url + "/news/podcasts/" + episode.showSlug + "/" + episode.slug + "/") | safeJsonLd | safe }}{% if isPremiumTeaser %},
  "isAccessibleForFree": false,
  "offers": {
    "@type": "Offer",
    "url": {{ (metadata.url + episode.subscribeUrl) | safeJsonLd | safe }},
    "availability": "https://schema.org/InStock"
  }{% else %},
  "associatedMedia": {
    "@type": "MediaObject",
    "contentUrl": {{ episode.audioUrl | safeJsonLd | safe }},
    "encodingFormat": {{ episode.audioMimeType | safeJsonLd | safe }}
  }{% endif %}{% if show %},
  "partOfSeries": {
    "@type": "PodcastSeries",
    "name": {{ show.title | safeJsonLd | safe }},
    "url": {{ (metadata.url + "/podcasts/" + show.slug + "/") | safeJsonLd | safe }}
  }{% endif %}
}
</script>
