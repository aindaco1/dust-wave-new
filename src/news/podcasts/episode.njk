---
layout: layouts/new.njk
bodyModifier: podcast-episode-page
i18nRuntime: true
tags:
  - news
  - podcast
pagination:
  data: podcastEpisodePublications
  size: 1
  alias: episode
permalink: "news/podcasts/{{ episode.showSlug }}/{{ episode.slug }}/index.html"
eleventyComputed:
  title: "{{ episode.title }}"
  summary: "{{ episode.summary }}"
  date: "{{ episode.publicAt }}"
  description: "{{ episode.summary }}"
  language: "{{ (podcastShows | podcastShowBySlug(episode.showSlug)).language }}"
  og_image: "/img/podcasts/{{ episode.showSlug }}/{{ episode.slug }}/social-card.png"
  og_image_width: 1200
  og_image_height: 630
  og_alt: "{{ episode.title }} · Dust Wave Podcasts"
---

{% set show = podcastShows | podcastShowBySlug(episode.showSlug) %}
{% set isPremiumTeaser = episode.pageMode == "premium_teaser" %}
{% set subscribePath = "/es" + episode.subscribeUrl if language == "es" else episode.subscribeUrl %}
<article class="podcast-episode h-entry">
  <div class="container py-vh-3">
    <p class="podcast-show__eyebrow">
      {% if isPremiumTeaser %}
      {{ i18n | t(language, "podcast.premiumEpisode") }}
      {% else %}
      {{ i18n | t(language, "podcast.episode.dustWaveEpisode") }}
      {% endif %}
    </p>
    <h1 class="p-name">{{ episode.title }}</h1>
    {% if show %}
    <p><a href="{% if language == 'es' %}/es{% endif %}/podcasts/{{ show.slug }}/">{{ show.title }}</a></p>
    {% endif %}
    <p class="p-summary">{{ episode.summary }}</p>
    <time class="dt-published" datetime="{{ episode.publicAt }}">{{ episode.publicAt | readablePodcastDate }}</time>

    {% if not isPremiumTeaser %}
    {% set playerId = episode.showSlug + "_" + episode.slug %}
    {% set title = episode.title %}
    {% set audioUrl = episode.audioUrl %}
    {% set downloadUrl = episode.downloadUrl or episode.audioUrl %}
    {% set artworkUrl = show.artwork if show else null %}
    {% set artworkAlt = i18n | t(language, "podcast.artworkAlt", { title: (show.title if show else episode.title) }) %}
    {% set peaksUrl = episode.peaksUrl %}
    {% set playerLanguage = show.language if show else "es" %}
    {% set analyticsEndpoint = podcastApi.apiOrigin + "/v1/analytics/player-events" %}
    {% set analyticsEpisodeId = episode.id %}
    {% include "snippets/audio-player.njk" %}
    {% endif %}

    <div class="e-content">
      {% if isPremiumTeaser %}
      <section class="podcast-premium-teaser" aria-labelledby="podcast-premium-teaser-title">
        <p class="podcast-premium-teaser__label">{{ i18n | t(language, "podcast.episode.subscribersOnly") }}</p>
        <h2 id="podcast-premium-teaser-title">{{ i18n | t(language, "podcast.episode.premiumTitle") }}</h2>
        <p>{{ i18n | t(language, "podcast.episode.premiumBody") }}</p>
        <a
          class="btn btn-dark podcast-premium-teaser__cta"
          href="{{ subscribePath }}">
          {{ i18n | t(language, "podcast.episode.premiumCta") }}
        </a>
      </section>
      {% else %}
      <h2>{{ i18n | t(language, "podcast.episode.notes") }}</h2>
      <p>{{ episode.summary }}</p>
      {% set chapterUrl = episode.chapterUrl or ("https://feeds.dustwave.xyz/v1/shows/" + episode.showSlug + "/episodes/" + episode.slug + "/chapters.json") %}
      <section
        class="podcast-chapters"
        data-podcast-chapters
        data-endpoint="{{ chapterUrl }}"
        data-player-id="{{ playerId }}"
        data-language="{{ playerLanguage }}"
        aria-labelledby="podcast-chapters-heading">
        <h2 id="podcast-chapters-heading">{{ i18n | t(language, "podcast.episode.chapters") }}</h2>
        <p
          class="podcast-chapters__status"
          data-podcast-chapters-status
          aria-live="polite">
          {{ i18n | t(language, "podcast.episode.chaptersEmpty") }}
        </p>
        <div
          class="podcast-chapters__content"
          data-podcast-chapters-content
          hidden></div>
      </section>
      {% set clipUrl = episode.clipUrl or (podcastApi.apiOrigin + "/v1/shows/" + episode.showSlug + "/episodes/" + episode.slug + "/clips") %}
      <section
        class="podcast-clips"
        data-podcast-clips
        data-endpoint="{{ clipUrl }}"
        data-show-slug="{{ episode.showSlug }}"
        data-episode-slug="{{ episode.slug }}"
        aria-labelledby="podcast-clips-heading"
        hidden>
        <h2 id="podcast-clips-heading">{{ i18n | t(language, "podcast.episode.clips") }}</h2>
        <p
          class="podcast-clips__status"
          data-podcast-clips-status
          aria-live="polite">
          {{ i18n | t(language, "podcast.episode.clipsEmpty") }}
        </p>
        <div
          class="podcast-clips__content"
          data-podcast-clips-content
          hidden></div>
      </section>
      {% set transcriptUrl = episode.transcriptUrl or ("https://feeds.dustwave.xyz/v1/shows/" + episode.showSlug + "/episodes/" + episode.slug + "/transcripts") %}
      <section
        class="podcast-transcript"
        data-podcast-transcript
        data-endpoint="{{ transcriptUrl }}"
        data-player-id="{{ playerId }}"
        data-language="{{ playerLanguage }}"
        aria-labelledby="podcast-transcript-heading">
        <h2 id="podcast-transcript-heading">{{ i18n | t(language, "podcast.episode.transcript") }}</h2>
        <p
          class="podcast-transcript__status"
          data-podcast-transcript-status
          aria-live="polite">
          {{ i18n | t(language, "podcast.episode.transcriptEmpty") }}
        </p>
        <div
          class="podcast-transcript__content"
          data-podcast-transcript-content
          hidden></div>
      </section>
      {% endif %}
    </div>
  </div>
</article>

{% if not isPremiumTeaser %}
<script src="/js/podcast-chapters.js?v={{ assets.version | default('dev') }}" defer></script>
<script src="/js/podcast-clips.js?v={{ assets.version | default('dev') }}" defer></script>
<script src="/js/podcast-transcript.js?v={{ assets.version | default('dev') }}" defer></script>
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  "name": {{ episode.title | safeJsonLd | safe }},
  "description": {{ episode.summary | safeJsonLd | safe }},
  "datePublished": {{ episode.publicAt | safeJsonLd | safe }},
  "url": {{ (metadata.url + "/news/podcasts/" + episode.showSlug + "/" + episode.slug + "/") | safeJsonLd | safe }}{% if isPremiumTeaser %},
  "isAccessibleForFree": false,
  "offers": {
    "@type": "Offer",
    "url": {{ (metadata.url + subscribePath) | safeJsonLd | safe }},
    "availability": "https://schema.org/InStock"
  }{% else %},
  "associatedMedia": {
    "@type": "MediaObject",
    "contentUrl": {{ episode.audioUrl | safeJsonLd | safe }},
    "encodingFormat": {{ episode.audioMimeType | safeJsonLd | safe }}
  }{% endif %}{% if show %},
  "partOfSeries": {
    "@type": "PodcastSeries",
    "name": {{ show.title | safeJsonLd | safe }},
    "url": {{ (metadata.url + ("/es" if language == "es" else "") + "/podcasts/" + show.slug + "/") | safeJsonLd | safe }}
  }{% endif %}
}
</script>
