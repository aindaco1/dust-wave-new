---
layout: layouts/default.njk
navbar: navbar1
footer: footer1
colorModifier: dark
translationKey: survey
eleventyExcludeFromCollections: true
pagination:
  data: i18n.config.supportedLangs
  size: 1
  alias: language
permalink: "{{ i18n.config.pages.survey[language] }}"
eleventyComputed:
  title: "{{ staticLocalePages.survey[language].title }}"
  description: "{{ staticLocalePages.survey[language].title }}"
---
{% set survey = staticLocalePages.survey[language] %}
<style>
  #popup { display: none !important; }
</style>

<div class="container">
  <div class="row d-flex justify-content-center">
    <div class="site-page-heading col-12 text-center">
      <h1>{{ title }}</h1>
    </div>
    <div class="col-11 col-lg-10 col-xl-8 border-bottom border-top py-vh-3">
      <div class="contact-form survey">
        <form method="post" action="https://formspree.io/f/xqkraazw" id="survey-form">
          <div class="contact-form__item">
            <h2><label class="contact-form__label" for="survey-name">{{ survey.name }} *</label></h2>
            <input id="survey-name" type="text" name="name" placeholder="{{ survey.namePlaceholder }}" class="contact-form__input" autocomplete="name" required>
          </div>

          {% set projectGroups = [
            { id: "project", heading: survey.projectQuestion },
            { id: "tech", heading: survey.technicalQuestion }
          ] %}
          {% for group in projectGroups %}
          <fieldset class="contact-form__item">
            <legend><h2>{{ group.heading }}</h2></legend>
            {% for option in survey.projectOptions %}
            <input type="checkbox" id="{{ group.id }}-{{ option.key }}" name="{{ group.id }}-{{ option.key }}" value="Y">
            <label for="{{ group.id }}-{{ option.key }}"><strong>{{ option.label }}</strong></label><br>
            {% endfor %}
          </fieldset>
          {% endfor %}

          <div class="contact-form__item">
            <h2><label class="contact-form__label" for="survey-projects">{{ survey.projectDetails }}</label></h2>
            <textarea id="survey-projects" name="project" placeholder="{{ survey.projectDetailsPlaceholder }}" class="contact-form__textarea"></textarea>
          </div>

          <fieldset class="contact-form__item">
            <legend><h2>{{ survey.expensesQuestion }}</h2></legend>
            {% for option in survey.expenseOptions %}
            <input type="checkbox" id="expenses-{{ option.key }}" name="expenses-{{ option.key }}" value="Y">
            <label for="expenses-{{ option.key }}"><strong>{{ option.label }}</strong></label><br>
            {% endfor %}
          </fieldset>

          <fieldset class="contact-form__item">
            <legend><h2>{{ survey.fundraisingQuestion }}</h2></legend>
            {% for option in survey.fundraisingOptions %}
            <input type="checkbox" id="fundraising-{{ option.key }}" name="fundraising-{{ option.key }}" value="Y">
            <label for="fundraising-{{ option.key }}"><strong>{{ option.label }}</strong></label><br>
            {% if option.key == "restaurant" %}
            <p class="survey__help">{{ survey.restaurantHelp }}</p>
            {% endif %}
            {% endfor %}
          </fieldset>

          <fieldset class="contact-form__item">
            <legend><h2>{{ survey.contributeQuestion }}</h2></legend>
            {% for option in survey.contributionOptions %}
            <input type="checkbox" id="contribute-{{ option.key }}" name="contribute-{{ option.key }}" value="Y">
            <label for="contribute-{{ option.key }}"><strong>{{ option.label }}</strong></label><br>
            {% if survey.contributionHelp[option.key] %}
            <p class="survey__help">{{ survey.contributionHelp[option.key] }}</p>
            {% endif %}
            {% endfor %}
          </fieldset>

          <div class="contact-form__item">
            <h2><label class="contact-form__label" for="survey-fundraising-ideas">{{ survey.otherIdeas }}</label></h2>
            <textarea id="survey-fundraising-ideas" name="other-fundraising-ideas" placeholder="{{ survey.otherIdeasPlaceholder }}" class="contact-form__textarea"></textarea>
          </div>

          <div class="contact-form__item">
            <h2><label class="contact-form__label" for="survey-budget">{{ survey.budget }}</label></h2>
            <input id="survey-budget" type="text" name="budget-guess" placeholder="{{ survey.budgetPlaceholder }}" class="contact-form__input">
          </div>

          <div class="cf-turnstile" data-sitekey="0x4AAAAAAAAudwxAIPEUguw8" data-callback="javascriptCallback" data-theme="light" data-language="{{ language }}"></div>
          <input type="hidden" name="_next" value="{{ i18n | localizedUrl(language, 'home', '/') }}">
          <input type="hidden" name="_subject" value="{{ survey.subject }}">

          <div class="contact-form__item">
            <button type="submit" class="button button--large border-color-white">{{ survey.submit }}</button>
          </div>
        </form>
      </div>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </div>
  </div>
</div>
