---
layout: layouts/default.njk
navbar: navbar1
footer: footer1
colorModifier: dark
translationKey: about
pagination:
  data: i18n.config.supportedLangs
  size: 1
  alias: language
permalink: "{{ i18n.config.pages.about[language] }}"
eleventyComputed:
  title: "{{ i18n[language].pages.about.title }}"
  description: "{{ i18n[language].pages.about.description }}"
---
<div class="container">
  <div class="row d-flex justify-content-center">
    <div class="col-12 text-center py-vh-3">
      <h1>{{title}}</h1>
    </div>
    <div class="col-10 col-lg-10 col-xl-9 border-bottom border-top py-vh-3">
      <div class="row">
        <ol>
          {% for belief in i18n | t(language, "pages.about.beliefs") %}
          <li>{{ belief }}</li>
          {% endfor %}
        </ol>
      </div>
    </div>
    <div class="col-12 text-center py-vh-3">
      <h1>{{ i18n | t(language, "pages.about.members") }}</h1>
      <div class="member-columns">
        {%- for member in collections.members -%}
        <article class="image_wrapper member-card">
          <img src="{{ member.data.img | toWebp }}" class="w-100 shadow-1-strong rounded" alt="{{ member.data.name }}" decoding="async">
          <div class="overlay overlay_3 white-text">
            <h3>{{ member.data.name }}</h3>
            {%- if member.data.instagram -%}
            &nbsp;
            &nbsp;
            <h3><a href="https://www.instagram.com/{{ member.data.instagram }}" class="link-fancy" target="_blank" rel="noopener noreferrer" aria-label="{{ i18n | t(language, 'pages.about.instagramAria', { name: member.data.name }) }}"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a></h3>
            {%- endif -%}
          </div>
        </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
