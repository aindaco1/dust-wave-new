        <section id="podcast-panel-distribution" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-distribution" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>{{ workbench.distribution.heading }}</h2>
              <p>{{ workbench.distribution.tagline }}</p>
            </div>
          </div>
          <details class="podcast-admin__advanced-tools podcast-admin__distribution-guidance">
            <summary>
              <strong>{{ workbench.distribution.guidanceSummary }}</strong>
              <span>{{ workbench.distribution.guidanceIntro }}</span>
            </summary>
            <div class="podcast-admin__distribution-guidance-body">
              <p>{{ workbench.distribution.canonicalFlow }}</p>
              <p>{{ workbench.distribution.retryFlow }}</p>
              <p>{{ workbench.distribution.evidenceFlow }}</p>
              <p>{{ workbench.distribution.credentialSafety }}</p>
            </div>
          </details>
          <form class="podcast-admin__distribution-filter" data-podcast-distribution-filter>
            <label data-podcast-distribution-release-picker>{{ workbench.distribution.releaseView }}
              <select name="episodeId">
                <option value="">{{ workbench.distribution.showSetup }}</option>
              </select>
            </label>
            <p data-podcast-distribution-release-picker>{{ workbench.distribution.filterHelp }}</p>
            <p data-podcast-distribution-no-releases hidden>{{ workbench.distribution.noReleaseEpisodes }}</p>
          </form>
          <div data-podcast-distribution aria-live="polite"></div>
        </section>
