        <section id="podcast-panel-settings" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-settings">
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>{{ workbench.overview.shows }}</h2>
              <p>{{ workbench.overview.intro }}</p>
            </div>
            <div class="podcast-admin__heading-actions">
              <button
                id="podcast-show-create-toggle"
                class="btn btn-danger"
                type="button"
                data-podcast-show-create-toggle
                aria-controls="podcast-show-create-panel"
                aria-expanded="false"
                hidden>{{ workbench.overview.createShow }}</button>
              <button class="btn btn-outline-light" type="button" data-podcast-refresh>{{ workbench.common.refresh }}</button>
            </div>
          </div>
          <section
            id="podcast-show-create-panel"
            class="podcast-admin__form podcast-admin__form--settings"
            data-podcast-show-create-panel
            aria-labelledby="podcast-show-create-heading"
            hidden>
            <div class="podcast-admin__panel-heading">
              <div>
                <h3 id="podcast-show-create-heading">{{ workbench.overview.createShowHeading }}</h3>
                <p>{{ workbench.overview.createShowIntro }}</p>
              </div>
              <p class="podcast-admin__pill">{{ workbench.overview.superAdminOnly }}</p>
            </div>
            <div class="podcast-admin__callout">
              <p>{{ workbench.overview.createShowSafety }}</p>
            </div>
            <form data-podcast-show-create-form>
              <section
                class="podcast-admin__field-group podcast-admin__field-group--compact"
                aria-labelledby="podcast-show-create-identity-heading">
                <h4 id="podcast-show-create-identity-heading">{{ workbench.overview.permanentIdentity }}</h4>
                <div class="podcast-admin__field-grid">
                  <label>{{ workbench.common.title }}
                    <input name="title" maxlength="200" autocomplete="off" required>
                  </label>
                  <label>{{ workbench.overview.urlSlug }}
                    <input
                      name="slug"
                      maxlength="120"
                      pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                      autocomplete="off"
                      spellcheck="false"
                      aria-describedby="podcast-show-create-slug-help"
                      required>
                  </label>
                </div>
                <p id="podcast-show-create-slug-help" class="podcast-admin__help">{{ workbench.overview.urlSlugHelp }}</p>
                <div class="podcast-admin__field-grid podcast-admin__field-grid--compact">
                  <label>{{ workbench.overview.primaryLanguage }}
                    <select name="language" required>
                      <option value="es">{{ workbench.common.spanish }}</option>
                      <option value="en">{{ workbench.common.english }}</option>
                    </select>
                  </label>
                  <label>{{ workbench.overview.showStatus }}
                    <input value="{{ workbench.overview.statusComingSoon }}" readonly aria-readonly="true">
                  </label>
                </div>
                <div class="podcast-admin__callout">
                  <p>{{ workbench.overview.permanentDestinationsHelp }}</p>
                  <div class="podcast-admin__field-grid">
                    <label>{{ workbench.overview.canonicalPage }}
                      <input name="canonicalUrl" type="url" readonly aria-readonly="true">
                    </label>
                    <label>{{ workbench.overview.rssFeed }}
                      <input name="feedUrl" type="url" readonly aria-readonly="true">
                    </label>
                  </div>
                </div>
              </section>
              <section
                class="podcast-admin__field-group"
                aria-labelledby="podcast-show-create-presentation-heading">
                <h4 id="podcast-show-create-presentation-heading">{{ workbench.overview.initialSettings }}</h4>
                <div class="podcast-admin__field-grid">
                  <label>{{ workbench.overview.authorName }}
                    <input name="authorName" maxlength="200">
                  </label>
                  <label>{{ workbench.overview.category }}
                    <input name="category" maxlength="200">
                  </label>
                </div>
                <label>{{ workbench.overview.descriptionSpanish }}
                  <textarea name="description" maxlength="10000" rows="4"></textarea>
                </label>
                <label>{{ workbench.overview.descriptionEnglish }}
                  <textarea name="descriptionEn" maxlength="10000" rows="4"></textarea>
                </label>
                <div class="podcast-admin__field-grid">
                  <label>{{ workbench.overview.artworkUrl }}
                    <input name="artworkUrl" type="url" inputmode="url" autocomplete="url" pattern="https://.*" maxlength="2000">
                  </label>
                  <label>{{ workbench.overview.youtubeChannel }}
                    <input
                      name="youtubeChannelUrl"
                      type="url"
                      inputmode="url"
                      autocomplete="url"
                      pattern="https://(www\.|m\.)?youtube\.com/(?:@|channel/|c/|user/).+"
                      maxlength="2000">
                  </label>
                  <label>{{ workbench.overview.earlyAccessDays }}
                    <input name="earlyAccessDays" type="number" min="0" max="365">
                  </label>
                </div>
                <label class="podcast-admin__checkbox">
                  <input name="explicit" type="checkbox"> {{ workbench.overview.explicit }}
                </label>
              </section>
              <section
                class="podcast-admin__field-group podcast-admin__field-group--compact"
                aria-labelledby="podcast-show-create-confirm-heading">
                <h4 id="podcast-show-create-confirm-heading">{{ workbench.overview.confirmPermanentIdentity }}</h4>
                <p>{{ workbench.overview.confirmPermanentIdentityHelp }}</p>
                <label>{{ workbench.overview.typedConfirmation }}
                  <input
                    name="confirmation"
                    autocomplete="off"
                    spellcheck="false"
                    aria-describedby="podcast-show-create-confirmation-value"
                    required>
                </label>
                <p id="podcast-show-create-confirmation-value" class="podcast-admin__help">
                  {{ workbench.overview.typeExactly }} <code data-podcast-show-create-confirmation>{{ workbench.overview.createShowConfirmationPrefix }}</code>
                </p>
              </section>
              <div class="podcast-admin__clip-actions">
                <button class="btn btn-danger" type="submit">{{ workbench.overview.createShowSubmit }}</button>
                <button class="btn btn-outline-light" type="button" data-podcast-show-create-cancel>{{ workbench.overview.cancelCreateShow }}</button>
              </div>
              <p class="podcast-admin__status" data-podcast-show-create-status role="status" aria-live="polite"></p>
            </form>
          </section>
          <div class="podcast-admin__cards" data-podcast-show-cards></div>
          <form class="podcast-admin__form podcast-admin__form--settings" data-podcast-show-form hidden>
            <section
              class="podcast-admin__field-group podcast-admin__field-group--compact"
              aria-labelledby="podcast-show-identity-heading">
              <h3 id="podcast-show-identity-heading">{{ workbench.overview.identityGroup }}</h3>
              <label>{{ workbench.common.title }}
                <input id="podcast-show-title" name="title" autocomplete="off" required>
              </label>
              <div class="podcast-admin__field-grid podcast-admin__field-grid--compact">
                <label>{{ workbench.overview.primaryLanguage }}
                  <select name="language" required>
                    <option value="es">{{ workbench.common.spanish }}</option>
                    <option value="en">{{ workbench.common.english }}</option>
                  </select>
                </label>
                <label>{{ workbench.overview.showStatus }}
                  <select name="status" required>
                    <option value="coming_soon">{{ workbench.overview.statusComingSoon }}</option>
                    <option value="active">{{ workbench.overview.statusActive }}</option>
                    <option value="archived">{{ workbench.overview.statusArchived }}</option>
                  </select>
                </label>
              </div>
              <div class="podcast-admin__field-grid">
                <label>{{ workbench.overview.authorName }}
                  <input name="authorName" maxlength="200">
                </label>
                <label>{{ workbench.overview.category }}
                  <input name="category" maxlength="200">
                </label>
              </div>
            </section>
            <section
              class="podcast-admin__field-group"
              aria-labelledby="podcast-show-presentation-heading">
              <h3 id="podcast-show-presentation-heading">{{ workbench.overview.presentationGroup }}</h3>
              <label>{{ workbench.overview.descriptionSpanish }}
                <textarea id="podcast-show-description" name="description" rows="4"></textarea>
              </label>
              <label>{{ workbench.overview.descriptionEnglish }}
                <textarea id="podcast-show-description-en" name="descriptionEn" rows="4"></textarea>
              </label>
              <label>{{ workbench.overview.artworkUrl }}
                <input
                  name="artworkUrl"
                  type="url"
                  inputmode="url"
                  autocomplete="url"
                  pattern="https://.*"
                  maxlength="2000">
              </label>
              <div class="podcast-admin__callout">
                <p>{{ workbench.overview.permanentDestinationsHelp }}</p>
                <div class="podcast-admin__field-grid">
                  <label>{{ workbench.overview.canonicalPage }}
                    <input name="canonicalUrl" type="url" readonly>
                  </label>
                  <label>{{ workbench.overview.rssFeed }}
                    <input name="feedUrl" type="url" readonly>
                  </label>
                </div>
              </div>
            </section>
            <section
              class="podcast-admin__field-group"
              aria-labelledby="podcast-show-release-defaults-heading">
              <h3 id="podcast-show-release-defaults-heading">{{ workbench.overview.releaseDefaultsGroup }}</h3>
              <div class="podcast-admin__field-grid">
                <label>{{ workbench.overview.earlyAccessDays }}
                  <input name="earlyAccessDays" type="number" min="0" max="365">
                </label>
                <label>{{ workbench.overview.youtubeChannel }}
                  <input
                    name="youtubeChannelUrl"
                    type="url"
                    inputmode="url"
                    autocomplete="url"
                    pattern="https://(www\.|m\.)?youtube\.com/(?:@|channel/|c/|user/).+"
                    maxlength="2000">
                </label>
              </div>
              <div class="podcast-admin__option-grid">
                <label class="podcast-admin__checkbox">
                  <input name="premiumEnabled" type="checkbox"> {{ workbench.overview.premiumEnabled }}
                </label>
                <label class="podcast-admin__checkbox">
                  <input name="freeMiniEpisodeEnabled" type="checkbox"> {{ workbench.overview.freeMiniEnabled }}
                </label>
                <label class="podcast-admin__checkbox">
                  <input name="explicit" type="checkbox"> {{ workbench.overview.explicit }}
                </label>
              </div>
            </section>
            <button class="btn btn-danger" type="submit">{{ workbench.overview.save }}</button>
            <p class="podcast-admin__status" data-podcast-show-status role="status" aria-live="polite"></p>
          </form>
          <section
            class="podcast-admin__form podcast-admin__form--settings"
            data-podcast-show-delete
            hidden>
            <h3>{{ workbench.overview.dangerZone }}</h3>
            <p>{{ workbench.overview.deleteShowIntro }}</p>
            <div class="podcast-admin__callout">
              <p><strong>{{ workbench.overview.deleteShowSafetyHeading }}</strong></p>
              <p>{{ workbench.overview.deleteShowSafety }}</p>
            </div>
            <button
              class="btn btn-danger"
              type="button"
              data-podcast-show-delete-toggle
              aria-expanded="false">
              {{ workbench.overview.deleteShow }}
            </button>
            <form data-podcast-show-delete-form hidden>
              <label>{{ workbench.overview.typedConfirmation }}
                <input
                  name="confirmation"
                  type="text"
                  autocomplete="off"
                  spellcheck="false"
                  aria-describedby="podcast-show-delete-confirmation-value"
                  required>
              </label>
              <p id="podcast-show-delete-confirmation-value" class="podcast-admin__help">
                {{ workbench.overview.typeExactly }} <code data-podcast-show-delete-confirmation></code>
              </p>
              <div class="podcast-admin__clip-actions">
                <button class="btn btn-danger" type="submit">{{ workbench.overview.deleteShowSubmit }}</button>
                <button class="btn btn-outline-light" type="button" data-podcast-show-delete-cancel>{{ workbench.overview.cancelDeleteShow }}</button>
              </div>
              <p class="podcast-admin__status" data-podcast-show-delete-status role="status" aria-live="polite"></p>
            </form>
          </section>
          <section
            class="podcast-admin__form podcast-admin__form--settings"
            data-podcast-show-prices
            hidden>
            <h3>{{ workbench.overview.priceSettingsHeading }}</h3>
            <p>{{ workbench.overview.priceSettingsIntro }}</p>
            <dl
              class="podcast-admin__readiness-evidence"
              data-podcast-show-prices-summary></dl>
            <ul
              class="podcast-admin__certification-list"
              data-podcast-show-prices-blockers
              hidden></ul>
            <form
              class="podcast-admin__callout"
              data-podcast-show-prices-form
              hidden>
              <div class="podcast-admin__field-grid">
                <label>{{ workbench.overview.monthlyPriceUsd }}
                  <input
                    name="monthlyDollars"
                    type="number"
                    inputmode="decimal"
                    min="1"
                    max="10000"
                    step="0.01"
                    autocomplete="off"
                    required>
                </label>
                <label>{{ workbench.overview.annualPriceUsd }}
                  <input
                    name="annualDollars"
                    type="number"
                    inputmode="decimal"
                    min="1"
                    max="10000"
                    step="0.01"
                    autocomplete="off"
                    required>
                </label>
              </div>
              <p>{{ workbench.overview.priceSettingsSafety }}</p>
              <p data-podcast-show-prices-confirmation-hint></p>
              <label>{{ workbench.overview.priceSettingsConfirmation }}
                <input
                  name="confirmation"
                  type="text"
                  autocomplete="off"
                  maxlength="140"
                  required>
              </label>
              <div class="podcast-admin__billing-actions">
                <button class="btn btn-danger" type="submit">
                  {{ workbench.overview.priceSettingsSave }}
                </button>
              </div>
            </form>
            <p
              class="podcast-admin__status"
              data-podcast-show-prices-status
              role="status"
              aria-live="polite"></p>
          </section>
          <section
            class="podcast-admin__form podcast-admin__form--settings"
            data-podcast-site-projection
            hidden>
            <h3>{{ workbench.overview.siteProjectionHeading }}</h3>
            <p>{{ workbench.overview.siteProjectionIntro }}</p>
            <div class="podcast-admin__billing-actions">
              <button
                class="btn btn-outline-light"
                type="button"
                data-podcast-site-projection-preview>
                {{ workbench.overview.siteProjectionPreview }}
              </button>
            </div>
            <p
              class="podcast-admin__status"
              data-podcast-site-projection-status
              role="status"
              aria-live="polite"></p>
            <div data-podcast-site-projection-summary hidden></div>
            <form
              class="podcast-admin__callout"
              data-podcast-site-projection-form
              hidden>
              <p>{{ workbench.overview.siteProjectionPublishHelp }}</p>
              <p data-podcast-site-projection-confirmation-hint></p>
              <label>{{ workbench.overview.siteProjectionConfirmation }}
                <input
                  name="confirmation"
                  autocomplete="off"
                  spellcheck="false"
                  maxlength="120"
                  required>
              </label>
              <button class="btn btn-danger" type="submit">
                {{ workbench.overview.siteProjectionPublish }}
              </button>
            </form>
          </section>
          <section
            class="podcast-admin__form podcast-admin__form--settings"
            data-podcast-launch-lab
            aria-labelledby="podcast-launch-lab-heading"
            hidden>
            <div class="podcast-admin__autopilot-heading">
              <div>
                <h3 id="podcast-launch-lab-heading">{{ workbench.overview.launchLabHeading }}</h3>
                <p>{{ workbench.overview.launchLabIntro }}</p>
              </div>
              <span
                class="podcast-admin__autopilot-state"
                data-podcast-launch-lab-state>{{ workbench.overview.launchLabPill }}</span>
            </div>
            <div class="podcast-admin__callout">
              <p>{{ workbench.overview.launchLabSafety }}</p>
            </div>
            <dl
              class="podcast-admin__autopilot-metrics"
              data-podcast-launch-lab-metrics></dl>
            <div class="podcast-admin__form-actions">
              <button
                class="btn btn-outline-light"
                type="button"
                data-podcast-launch-lab-refresh>{{ workbench.overview.launchLabRefresh }}</button>
              <button
                class="btn btn-outline-light"
                type="button"
                data-podcast-launch-lab-checkout>{{ workbench.overview.launchLabCheckout }}</button>
            </div>
            <p class="podcast-admin__help">{{ workbench.overview.launchLabCheckoutHelp }}</p>
            <p
              class="podcast-admin__status"
              data-podcast-launch-lab-status
              role="status"
              aria-live="polite"></p>
            <details
              class="podcast-admin__workflow-more-blockers"
              data-podcast-launch-lab-evidence
              hidden>
              <summary>{{ workbench.overview.launchLabEvidence }}</summary>
              <div
                class="podcast-admin__readiness-groups"
                data-podcast-launch-lab-providers></div>
            </details>
          </section>
          <details class="podcast-admin__advanced-tools">
            <summary>{{ workbench.overview.advancedTools }}</summary>
            <form class="podcast-admin__form podcast-admin__form--settings" data-podcast-rss-import-form hidden>
              <h3>{{ workbench.overview.importHeading }}</h3>
              <p>{{ workbench.overview.importIntro }}</p>
              <label>{{ workbench.overview.importFeedUrl }}
                <input name="feedUrl" type="url" inputmode="url" autocomplete="url" required>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="ownershipConfirmed" type="checkbox" required>
                {{ workbench.overview.importOwnership }}
              </label>
              <p class="podcast-admin__callout">{{ workbench.overview.importPreviewOnly }}</p>
              <button class="btn btn-outline-light" type="submit">{{ workbench.overview.previewImport }}</button>
              <p class="podcast-admin__status" data-podcast-rss-import-status role="status" aria-live="polite"></p>
              <div class="podcast-admin__readiness-groups" data-podcast-rss-import-preview aria-live="polite"></div>
            </form>
            <section class="podcast-admin__form podcast-admin__form--settings" data-podcast-rss-import-plan-section hidden>
              <h3>{{ workbench.overview.importPlansHeading }}</h3>
              <p>{{ workbench.overview.importPlansIntro }}</p>
              <p class="podcast-admin__callout">{{ workbench.overview.importPlansZeroCopy }}</p>
              <div class="podcast-admin__readiness-list" data-podcast-rss-import-plans aria-live="polite"></div>
            </section>
          </details>
        </section>
