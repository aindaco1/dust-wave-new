              <button class="btn btn-outline-light" type="button" data-podcast-clip-publication-withdraw hidden>{{ workbench.marketing.withdrawPublicClip }}</button>
              <button class="btn btn-outline-light" type="button" data-podcast-clip-publication-close>{{ workbench.marketing.close }}</button>
            </div>
            <p class="podcast-admin__status" data-podcast-clip-publication-status role="status" aria-live="polite"></p>
