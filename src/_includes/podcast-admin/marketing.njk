              <label class="podcast-admin__field-wide">{{ workbench.marketing.publicDescription }}
                <textarea name="description" maxlength="1000" rows="4"></textarea>
              </label>
            </div>
            <div class="podcast-admin__clip-actions">
              <button class="btn btn-outline-light" type="submit" data-podcast-clip-publication-save>{{ workbench.marketing.preparePublicClip }}</button>
