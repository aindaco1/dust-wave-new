---
permalink: "subdir/{{ title | slugify }}/index.html"
---
<!doctype html>
<html class="h-100" lang="{{ language or metadata.language }}">
  <head>
    {% include 'snippets/head.njk' %}
  </head>
  <body class="site-shell{% if bodyModifier %} {{ bodyModifier }}{% endif %}">
    <a class="skip-link" href="#main-content">{{ i18n | t(language, "nav.skipToContent") }}</a>
    {% include "snippets/navbar1.njk" %}
    <main id="main-content" class="site-main site-main--entry container" tabindex="-1">
      {# h-entry microformats wrapper for Fediverse/IndieWeb compatibility #}
      <article class="h-entry">
        <div class="row d-flex justify-content-center text-center">
          <div class="col-12 col-lg-10 col-xl-8">
            {% if author %}<small class="text-muted p-author">{{ i18n | t(language, "content.by") }} {{ author }}</small>{% endif %}
            <h1 class="display-huge p-name">{{ title }}</h1>
            <time class="dt-published visually-hidden" datetime="{{ date | htmlDateString }}">{{ date | localizedDate(language) }}</time>
            <a class="u-url visually-hidden" href="{{ metadata.url }}{{ page.url }}">{{ i18n | t(language, "content.permalink") }}</a>
            {# Plain text content for Bluesky (avoids HTML rendering issues) #}
            {% if syndicate and "fediverse" in syndicate %}<span class="p-bridgy-bluesky-content visually-hidden">{{ summary }}</span>{% endif %}
            <p class="lead pt-2 py-vh-2 p-summary {% if img or heroVideoWebm or heroVideoMp4 %}{% else %}border-bottom{% endif %}">{{summary}}{% if syndicate and "fediverse" in syndicate %} <a href="https://fed.brid.gy/r/{{ metadata.url }}{{ page.url }}" title="Federated to the Fediverse" class="text-decoration-none" target="_blank">📡</a>{% endif %}</p>
            {% include "snippets/project-metadata.njk" %}
          </div>
          {% if heroVideoWebm or heroVideoMp4 %}
            <div class="row">
              <div class="col-12">
                <video class="project-hero-video dropshadow" autoplay muted loop playsinline controls preload="metadata"{% if heroVideoPoster %} poster="{{ heroVideoPoster }}"{% endif %}{% if heroVideoLabel %} aria-label="{{ heroVideoLabel }}"{% endif %}>
                  {% if heroVideoWebm %}<source src="{{ heroVideoWebm }}" type="video/webm">{% endif %}
                  {% if heroVideoMp4 %}<source src="{{ heroVideoMp4 }}" type="video/mp4">{% endif %}
                  {% if img %}<img src="{{ img | toWebp }}" alt="{{ imgAlt }}">{% endif %}
                </video>
              </div>
            </div>
          {% elif img %}
            <div class="row">
              <div class="col-12">
                <img src="{{img | toWebp}}" class="img-fluid dropshadow u-photo{% if imgDisplay == 'compact' %} project-hero-image--compact{% endif %}" alt="{{imgAlt}}">
              </div>
            </div>
          {% endif %}
          <div class="row d-flex justify-content-center text-start">
            <div class="col-12 col-lg-10 col-xl-10 py-vh-2 e-content story-content project-content">
              {{ content | safe }}
              {% include "snippets/auto-gallery.njk" %}
            </div>
          </div>
        </div>
        
        {# Share panel #}
        <div class="row d-flex justify-content-center">
          <div class="col-12 col-lg-10 col-xl-10">
            {% include "snippets/share-panel.njk" %}
          </div>
        </div>

        {# Bridgy Fed opt-in (only for posts with syndicate containing "fediverse") #}
        {% include "snippets/bridgy-opt-in.njk" %}
      </article>
    </main>
    {% if not (isProject and language == "es") %}
    <div class="container-100 d-flex justify-content-between">
      {% include 'snippets/postprevnext.njk' %}
    </div>
    {% endif %}
    {% include "snippets/" + footer + ".njk" %}
  </body>
</html>
