<!doctype html>
<html class="h-100" lang="{{ language or metadata.language }}">
  <head>
    {% include "snippets/head.njk" %}
    <meta name="robots" content="noindex,nofollow,noarchive">
    {% if podcastAdmin.turnstileSiteKey %}
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin>
    {% endif %}
  </head>
  <body class="podcast-admin-page">
    {% include "snippets/navbar1.njk" %}
    <main id="main-content" class="podcast-admin" tabindex="-1">
      {{ content | safe }}
    </main>
    {% if podcastAdmin.turnstileSiteKey %}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
    {% endif %}
    <script src="/js/dust-wave-admin-shell/vendor/qrcode-generator.js" defer></script>
    <script src="/js/audio-player.js" defer></script>
    <script type="module" src="/js/podcast-admin.js"></script>
  </body>
</html>
