{# Masonry-style gallery from galleryImages frontmatter array. #}
{% if galleryImages and galleryImages.length > 0 %}
<div class="masonry-gallery">
  {% for image in galleryImages %}
    {% set imageSrc = image.src or image %}
    {% set imageAlt = image.alt or "Gallery image" %}
    <figure class="masonry-gallery__item">
      <img src="{{ imageSrc | toWebp }}" alt="{{ imageAlt }}" loading="lazy" decoding="async">
      {% if image.caption %}
        <figcaption>{{ image.caption }}</figcaption>
      {% endif %}
    </figure>
  {% endfor %}
</div>
{% endif %}
