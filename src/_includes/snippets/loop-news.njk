{%- for new in news -%}
    <article class="news-list-item col-12 border-top px-0 py-4 d-flex justify-content-between align-items-center {{ new.data.title | replace(" ", "-")}}">
      <h2 class="news-list-main news-list-title h4 mb-0"><a href="{{ new.url }}" class="white-text text-decoration-none">{{ new.data.title }}</a></h2>
      <time class="news-list-date" datetime="{{ new.date | htmlDateString }}">{{ new.date | localizedDate(language) }}</time>
    </article>
  {% endfor %}
