{# Project media sections generated from frontmatter. #}
{# Usage: {% include "snippets/auto-gallery.njk" %} #}

{% if galleryImages and galleryImages.length > 0 %}
<h3>{{ galleryHeading or "Behind the Scenes" }}</h3>
{% include "snippets/masonry-gallery.njk" %}
<br><br>
{% endif %}

{% if additionalGalleries and additionalGalleries.length > 0 %}
  {% for gallery in additionalGalleries %}
<h3>{{ gallery.heading }}</h3>
    {% set galleryImages = gallery.images %}
    {% include "snippets/masonry-gallery.njk" %}
<br><br>
  {% endfor %}
{% endif %}

{# Auto-render poster if present #}
{% if poster %}
<h3>{{ posterHeading or "Poster" }}</h3>
<img src="{{ poster | toWebp }}" class="w-75 shadow-1-strong rounded mb-2" alt="{{ posterAlt or posterHeading or 'Poster' }}" loading="lazy" decoding="async">
<br><br>
{% endif %}

{# Auto-render one or more project videos. #}
{% if projectVideos and projectVideos.length > 0 %}
  {% for video in projectVideos %}
<h2>{{ video.heading or movieHeading or "Movie" }}</h2>
<div class="embed-container">
    {% if video.type == "vimeo" %}
  <iframe src="https://player.vimeo.com/video/{{ video.id }}" title="{{ video.title or video.heading or 'Vimeo video player' }}" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    {% else %}
  <iframe src="https://www.youtube-nocookie.com/embed/{{ video.id }}?rel=0" title="{{ video.title or video.heading or 'YouTube video player' }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe>
    {% endif %}
</div>
<br><br>
  {% endfor %}
{% elif videoId %}
{# Backward compatibility for any non-project content still using one videoId. #}
<h2>{{ movieHeading or "Movie" }}</h2>
<div class="embed-container">
  {% if videoType == "vimeo" %}
  <iframe src="https://player.vimeo.com/video/{{ videoId }}" title="{{ videoTitle or movieHeading or 'Vimeo video player' }}" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
  {% else %}
  <iframe src="https://www.youtube-nocookie.com/embed/{{ videoId }}?rel=0" title="{{ videoTitle or movieHeading or 'YouTube video player' }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe>
  {% endif %}
</div>
<br><br>
{% endif %}

{% if movieComingSoon %}
<h2>{{ movieHeading or "Movie" }}</h2>
<p><strong>{{ i18n | t(language, 'pages.projects.movieComingSoon') }}</strong></p>
{% endif %}
