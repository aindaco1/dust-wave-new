{# Share panel for news and project pages #}
{% set shareUrl = metadata.url + page.url %}
{% set shareTitle = share_text or (title + " — Dust Wave") %}
{% set shareText = shareTitle + " " + shareUrl %}

<div class="share-panel my-4 py-3 border-top border-bottom">
  <div class="d-flex flex-wrap align-items-center justify-content-center gap-1">
    
    {# Primary share button - uses Web Share API if available #}
    {# Share links - all evenly spaced #}
    <div class="share-links d-flex flex-wrap align-items-center justify-content-center gap-2">

      {# Primary share button - uses Web Share API if available #}
      <button type="button" class="share-primary" 
              data-share-url="{{ shareUrl }}" 
              data-share-title="{{ shareTitle }}"
              data-share-text="{{ shareTitle }}">
        {% icon "share", "me-1" %} {{ i18n | t(language, "share.share") }}
      </button>
      
      {# Mastodon - requires instance selection #}
      <button type="button" class="share-mastodon" 
              data-share-text="{{ shareText }}"
              aria-label="{{ i18n | t(language, 'share.shareOn', { network: 'Mastodon' }) }}">
        {% icon "mastodon" %}
      </button>

      {# Bluesky #}
      <a href="https://bsky.app/intent/compose?text={{ shareText | urlencode }}" 
         target="_blank" rel="noopener noreferrer" class="share-link"
         aria-label="{{ i18n | t(language, 'share.shareOn', { network: 'Bluesky' }) }}">
        {% icon "bluesky" %}
      </a>

      {# X (Twitter) #}
      <a href="https://twitter.com/intent/tweet?text={{ shareTitle | urlencode }}&url={{ shareUrl | urlencode }}" 
         target="_blank" rel="noopener noreferrer" class="share-link"
         aria-label="{{ i18n | t(language, 'share.shareOn', { network: 'X' }) }}">
        {% icon "x" %}
      </a>

      {# Threads #}
      <a href="https://www.threads.net/intent/post?text={{ shareText | urlencode }}" 
         target="_blank" rel="noopener noreferrer" class="share-link"
         aria-label="{{ i18n | t(language, 'share.shareOn', { network: 'Threads' }) }}">
        {% icon "threads" %}
      </a>

      {# LinkedIn #}
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl | urlencode }}" 
         target="_blank" rel="noopener noreferrer" class="share-link"
         aria-label="{{ i18n | t(language, 'share.shareOn', { network: 'LinkedIn' }) }}">
        {% icon "linkedin" %}
      </a>

      {# Facebook #}
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl | urlencode }}" 
         target="_blank" rel="noopener noreferrer" class="share-link"
         aria-label="{{ i18n | t(language, 'share.shareOn', { network: 'Facebook' }) }}">
        {% icon "facebook" %}
      </a>

      {# Reddit #}
      <a href="https://www.reddit.com/submit?url={{ shareUrl | urlencode }}&title={{ shareTitle | urlencode }}" 
         target="_blank" rel="noopener noreferrer" class="share-link"
         aria-label="{{ i18n | t(language, 'share.shareOn', { network: 'Reddit' }) }}">
        {% icon "reddit" %}
      </a>

      {# Email #}
      <a href="mailto:?subject={{ shareTitle | urlencode }}&body={{ shareText | urlencode }}" 
         class="share-link" aria-label="{{ i18n | t(language, 'share.shareByEmail') }}">
        {% icon "envelope" %}
      </a>

      {# Copy link #}
      <button type="button" class="copy-link" 
              data-copy-url="{{ shareUrl }}" aria-label="{{ i18n | t(language, 'share.copyLink') }}">
        <span data-copy-icon="link">{% icon "link" %}</span>
        <span data-copy-icon="check" hidden>{% icon "check" %}</span>
      </button>

    </div>
  </div>
</div>

{# Mastodon instance modal #}
<dialog class="modal" id="mastodonModal" aria-labelledby="mastodonModalLabel">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-white">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="mastodonModalLabel">
          {% icon "mastodon", "me-2" %}{{ i18n | t(language, "share.mastodonTitle") }}
        </h5>
        <button type="button" class="btn-close btn-close-white" data-dialog-close aria-label="{{ i18n | t(language, 'share.close') }}"></button>
      </div>
      <div class="modal-body">
        <label for="mastodonInstance" class="form-label">{{ i18n | t(language, "share.instanceLabel") }}</label>
        <div class="input-group">
          <span class="input-group-text bg-secondary border-secondary text-white">https://</span>
          <input type="text" class="form-control bg-dark text-white border-secondary" 
                 id="mastodonInstance" placeholder="mastodon.social"
                 inputmode="url" autocomplete="url"
                 value="">
        </div>
        <small class="text-muted">{{ i18n | t(language, "share.instanceHelp") }}</small>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-secondary" data-dialog-close>{{ i18n | t(language, "share.cancel") }}</button>
        <button type="button" class="btn btn-primary" id="mastodonShareConfirm">{{ i18n | t(language, "share.share") }}</button>
      </div>
    </div>
  </div>
</dialog>

<script>
(function() {
  // Web Share API for primary share button
  const primaryBtn = document.querySelector('.share-primary');
  if (primaryBtn) {
    primaryBtn.addEventListener('click', async function() {
      const shareData = {
        title: this.dataset.shareTitle,
        text: this.dataset.shareText,
        url: this.dataset.shareUrl
      };
      
      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (err) {
          if (err.name !== 'AbortError') {
            console.log('Share failed:', err);
          }
        }
      } else {
        // Fallback: scroll to share links if not visible
        document.querySelector('.share-links')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }

  // Copy link functionality
  document.querySelectorAll('.copy-link').forEach(btn => {
    btn.addEventListener('click', async function() {
      const url = this.dataset.copyUrl;
      try {
        await navigator.clipboard.writeText(url);
        const linkIcon = this.querySelector('[data-copy-icon="link"]');
        const checkIcon = this.querySelector('[data-copy-icon="check"]');
        linkIcon.hidden = true;
        checkIcon.hidden = false;
        setTimeout(() => {
          linkIcon.hidden = false;
          checkIcon.hidden = true;
        }, 2000);
      } catch (err) {
        console.log('Copy failed:', err);
      }
    });
  });

  // Mastodon share with instance selection
  const MASTODON_INSTANCE_KEY = 'dustwave_mastodon_instance';
  const invalidMastodonInstance = {{ i18n | t(language, "share.invalidInstance") | safeJsonLd | safe }};
  const mastodonDialog = document.getElementById('mastodonModal');
  let pendingMastodonText = '';

  function normalizeMastodonInstance(value) {
    const candidate = value.trim().replace(/^https?:\/\//i, '').replace(/\/+$/, '');
    if (!/^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::\d{2,5})?$/i.test(candidate)) {
      return '';
    }
    try {
      const parsed = new URL(`https://${candidate}`);
      if (parsed.username || parsed.password || parsed.pathname !== '/' || parsed.search || parsed.hash) {
        return '';
      }
      return parsed.host;
    } catch {
      return '';
    }
  }

  document.querySelectorAll('.share-mastodon').forEach(btn => {
    btn.addEventListener('click', function() {
      pendingMastodonText = this.dataset.shareText;
      const savedInstance = localStorage.getItem(MASTODON_INSTANCE_KEY) || '';
      document.getElementById('mastodonInstance').value = savedInstance;
      mastodonDialog.showModal();
    });
  });

  document.getElementById('mastodonShareConfirm')?.addEventListener('click', function() {
    const instanceInput = document.getElementById('mastodonInstance');
    const instance = normalizeMastodonInstance(instanceInput.value);
    instanceInput.setCustomValidity(instance ? '' : invalidMastodonInstance);
    if (instance) {
      localStorage.setItem(MASTODON_INSTANCE_KEY, instance);
      const shareUrl = `https://${instance}/share?text=${encodeURIComponent(pendingMastodonText)}`;
      window.open(shareUrl, '_blank', 'noopener');
      mastodonDialog.close();
    } else {
      instanceInput.reportValidity();
    }
  });

  // Allow Enter key to submit in modal
  document.getElementById('mastodonInstance')?.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      document.getElementById('mastodonShareConfirm').click();
    }
  });

  mastodonDialog?.querySelectorAll('[data-dialog-close]').forEach((button) => {
    button.addEventListener('click', () => mastodonDialog.close());
  });
})();
</script>
