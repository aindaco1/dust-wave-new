---
layout: layouts/podcast-admin.njk
title: Podcast Admin — Dust Wave
description: Private Dust Wave Podcast publishing workbench.
language: en
permalink: admin/podcasts/index.html
---

<div
  class="podcast-admin__container"
  data-podcast-admin
  data-api-origin="{{ podcastAdmin.apiOrigin }}"
  data-turnstile-site-key="{{ podcastAdmin.turnstileSiteKey }}">
  <a class="visually-hidden-focusable" href="#podcast-admin-content">Skip to Podcast admin content</a>

  <header class="podcast-admin__header">
    <div>
      <p class="podcast-admin__eyebrow">Dust Wave Admin</p>
      <h1>Podcasts</h1>
      <p>Multi-show publishing, media, distribution, premium, and launch readiness.</p>
    </div>
    <button class="btn btn-outline-light" type="button" data-podcast-logout hidden>Log out</button>
  </header>

  <p class="podcast-admin__status" data-podcast-global-status role="status" aria-live="polite"></p>

  <section class="podcast-admin__auth" data-podcast-auth aria-labelledby="podcast-login-title">
    <h2 id="podcast-login-title">Sign in</h2>
    <p>We’ll email a private, single-use link. / Te enviaremos un enlace privado de un solo uso.</p>
    <form data-podcast-login-form>
      <label for="podcast-admin-email">Email</label>
      <div class="podcast-admin__inline-form">
        <input id="podcast-admin-email" name="email" type="email" autocomplete="email" required>
        <button class="btn btn-danger" type="submit">Send link</button>
      </div>
      {% if podcastAdmin.turnstileSiteKey %}
      <div id="podcast-turnstile" class="podcast-admin__turnstile"></div>
      {% endif %}
    </form>
    <p class="podcast-admin__status" data-podcast-auth-status role="status" aria-live="polite"></p>
  </section>

  <section class="podcast-admin__app" data-podcast-app hidden>
    <p class="podcast-admin__session" data-podcast-session-summary></p>

    <div class="podcast-admin__tabs" data-podcast-tabs>
      <div class="podcast-admin__tab-list" role="tablist" aria-label="Podcast administration">
        <button id="podcast-tab-overview" type="button" role="tab" data-tab="overview" aria-controls="podcast-panel-overview">Overview</button>
        <button id="podcast-tab-episodes" type="button" role="tab" data-tab="episodes" aria-controls="podcast-panel-episodes">Episodes</button>
        <button id="podcast-tab-production" type="button" role="tab" data-tab="production" aria-controls="podcast-panel-production">Production</button>
        <button id="podcast-tab-distribution" type="button" role="tab" data-tab="distribution" aria-controls="podcast-panel-distribution">Distribution</button>
        <button id="podcast-tab-marketing" type="button" role="tab" data-tab="marketing" aria-controls="podcast-panel-marketing">Marketing</button>
        <button id="podcast-tab-sponsors" type="button" role="tab" data-tab="sponsors" aria-controls="podcast-panel-sponsors">Sponsors</button>
        <button id="podcast-tab-analytics" type="button" role="tab" data-tab="analytics" aria-controls="podcast-panel-analytics">Analytics</button>
        <button id="podcast-tab-billing" type="button" role="tab" data-tab="billing" aria-controls="podcast-panel-billing">Premium</button>
      </div>

      <div id="podcast-admin-content">
        <section id="podcast-panel-overview" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-overview">
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Shows</h2>
              <p>Single-show launch interface; the API and data model support more shows.</p>
            </div>
            <button class="btn btn-outline-light" type="button" data-podcast-refresh>Refresh</button>
          </div>
          <div class="podcast-admin__cards" data-podcast-show-cards></div>

          <form class="podcast-admin__form podcast-admin__form--settings" data-podcast-show-form hidden>
            <h3>Show settings</h3>
            <label for="podcast-show-title">Title</label>
            <input id="podcast-show-title" name="title" required>
            <label for="podcast-show-description">Descripción (ES)</label>
            <textarea id="podcast-show-description" name="description" rows="4"></textarea>
            <label for="podcast-show-description-en">Description (EN)</label>
            <textarea id="podcast-show-description-en" name="descriptionEn" rows="4"></textarea>
            <div class="podcast-admin__field-grid">
              <label>Early access days
                <input name="earlyAccessDays" type="number" min="0" max="365">
              </label>
              <label>YouTube channel
                <input name="youtubeChannelUrl" type="url">
              </label>
            </div>
            <label class="podcast-admin__checkbox">
              <input name="premiumEnabled" type="checkbox"> Premium enabled
            </label>
            <label class="podcast-admin__checkbox">
              <input name="freeMiniEpisodeEnabled" type="checkbox"> One free mini-episode enabled
            </label>
            <button class="btn btn-danger" type="submit">Save show settings</button>
            <p class="podcast-admin__status" data-podcast-show-status role="status" aria-live="polite"></p>
          </form>
        </section>

        <section id="podcast-panel-episodes" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-episodes" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Episodes</h2>
              <p>Create the canonical episode record, attach delivery media, then publish one reviewed revision.</p>
            </div>
            <select data-podcast-show-select aria-label="Show"></select>
          </div>

          <form class="podcast-admin__form" data-podcast-episode-form>
            <h3>New episode</h3>
            <div class="podcast-admin__field-grid">
              <label>Title
                <input name="title" required>
              </label>
              <label>URL slug
                <input name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required>
              </label>
            </div>
            <label>Summary
              <textarea name="summary" rows="3" required></textarea>
            </label>
            <label>Episode notes</label>
            <div class="podcast-admin__editor" data-podcast-notes-editor></div>
            <div class="podcast-admin__field-grid podcast-admin__field-grid--three">
              <label>Access
                <select name="access">
                  <option value="public">Public</option>
                  <option value="early_access">Early access</option>
                  <option value="premium_bonus">Premium bonus</option>
                  <option value="free_mini">Free mini-episode</option>
                </select>
              </label>
              <label>Premium release
                <input name="premiumAt" type="datetime-local">
              </label>
              <label>Public release
                <input name="publicAt" type="datetime-local">
              </label>
            </div>
            <button class="btn btn-danger" type="submit">Create draft</button>
            <p class="podcast-admin__status" data-podcast-episode-status role="status" aria-live="polite"></p>
          </form>

          <form class="podcast-admin__form" data-podcast-upload-form>
            <h3>Attach media</h3>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select name="episodeId" required></select>
              </label>
              <label>Media role
                <select name="kind">
                  <option value="delivery_audio">Delivery audio</option>
                  <option value="source_audio">Source audio</option>
                  <option value="video_source">Video source</option>
                </select>
              </label>
            </div>
            <label>File
              <input name="media" type="file" accept="audio/*,video/mp4,video/quicktime,video/webm" required>
            </label>
            <progress data-podcast-upload-progress max="100" value="0" hidden></progress>
            <button class="btn btn-outline-light" type="submit">Upload media</button>
            <p class="podcast-admin__status" data-podcast-upload-status role="status" aria-live="polite"></p>
          </form>

          <form class="podcast-admin__form" data-podcast-ad-plan-form hidden>
            <h3>Dynamic-ad markers and program segments</h3>
            <p>Submit producer marker intent, process one normalized MP3 into frame-safe program segments, then review the evidence before approval. Approval does not enable request-time ads.</p>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select name="episodeId" required></select>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="preRoll" type="checkbox"> Pre-roll
              </label>
              <label class="podcast-admin__checkbox">
                <input name="midRoll" type="checkbox"> Mid-roll
              </label>
              <label>Mid-roll time (seconds)
                <input name="midRollSeconds" type="number" min="1" step="1" disabled>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="postRoll" type="checkbox"> Post-roll
              </label>
            </div>
            <button class="btn btn-outline-light" type="submit">Submit frame-safe plan</button>
            <p class="podcast-admin__status" data-podcast-ad-plan-status role="status" aria-live="polite"></p>
          </form>
          <div data-podcast-ad-plan-result aria-live="polite"></div>

          <div class="podcast-admin__episode-list" data-podcast-episode-list></div>
        </section>

        <section id="podcast-panel-production" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-production" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Transcript review</h2>
              <p>Edit bilingual timed cues with the shared Pool/Store editor, confirm public speaker labels, and approve a versioned revision.</p>
            </div>
            <p class="podcast-admin__pill">Word timing gated</p>
          </div>
          <div class="podcast-admin__callout">
            <p>Cue editing does not invent word timing. Word-linked navigation and word-accurate clip cuts remain unavailable until a matching English/Spanish alignment revision passes the launch quality gate.</p>
          </div>
          <div class="podcast-admin__form" data-podcast-transcript-workbench>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select data-podcast-transcript-episode required></select>
              </label>
              <label>Transcript language
                <select data-podcast-transcript-language>
                  <option value="es">Español</option>
                  <option value="en">English</option>
                </select>
              </label>
            </div>
            <div class="podcast-admin__transcript-meta" data-podcast-transcript-meta aria-live="polite"></div>
            <div class="podcast-admin__transcript-cues" data-podcast-transcript-cues></div>
            <nav class="podcast-admin__transcript-pages" data-podcast-transcript-pages aria-label="Transcript cue pages" hidden>
              <button class="btn btn-outline-light" type="button" data-podcast-transcript-previous>Previous cues</button>
              <span data-podcast-transcript-page aria-live="polite"></span>
              <button class="btn btn-outline-light" type="button" data-podcast-transcript-next>Next cues</button>
            </nav>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-transcript-add>Add cue</button>
              <button class="btn btn-danger" type="button" data-podcast-transcript-save>Save review draft</button>
              <button class="btn btn-outline-light" type="button" data-podcast-transcript-approve>Approve revision</button>
            </div>
            <p class="podcast-admin__status" data-podcast-transcript-status role="status" aria-live="polite"></p>
          </div>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
              <h2>Clip factory</h2>
              <p>Save a captioned audiogram recipe from an approved transcript range, then preview and download completed private renders.</p>
            </div>
            <p class="podcast-admin__pill">Private evidence only</p>
          </div>
          <div class="podcast-admin__callout">
            <p>Segment-boundary clips are available first. Word-accurate cuts stay locked until the matching transcript alignment passes H1. Preparing a manifest does not publish a clip; completed private renders appear below for authenticated preview and download.</p>
          </div>
          <form class="podcast-admin__form" data-podcast-clip-form>
            <div class="podcast-admin__field-grid">
              <label>Clip title
                <input name="title" maxlength="160" required>
              </label>
              <label>Format
                <select name="aspectRatio">
                  <option value="9:16">Vertical · 9:16</option>
                  <option value="1:1">Square · 1:1</option>
                  <option value="16:9">Landscape · 16:9</option>
                </select>
              </label>
              <label>Start cue
                <select name="startCueId" required></select>
              </label>
              <label>End cue
                <select name="endCueId" required></select>
              </label>
              <label>Boundary precision
                <select name="boundaryMode" disabled>
                  <option value="segment">Approved cue boundaries</option>
                  <option value="word">Word boundaries · H1 locked</option>
                </select>
              </label>
              <label>Template
                <select name="templateId" disabled>
                  <option value="captioned-waveform-v1">Captioned waveform v1</option>
                </select>
              </label>
            </div>
            <div class="podcast-admin__clip-preview" data-podcast-clip-preview aria-live="polite"></div>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-clip-new>New recipe</button>
              <button class="btn btn-danger" type="submit">Save clip recipe</button>
              <button class="btn btn-outline-light" type="button" data-podcast-clip-render>Prepare processor manifest</button>
            </div>
            <p class="podcast-admin__status" data-podcast-clip-status role="status" aria-live="polite"></p>
          </form>
          <div class="podcast-admin__clip-list" data-podcast-clip-list></div>
        </section>

        <section id="podcast-panel-distribution" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-distribution" hidden>
          <h2>Streamlined publishing</h2>
          <p>One reviewed revision fans out to the feed, canonical News page, YouTube, and monitored directory ingestion.</p>
          <div data-podcast-distribution></div>
        </section>

        <section id="podcast-panel-marketing" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-marketing" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Clip library</h2>
              <p>Find completed captioned clips across the selected show, then preview or download the exact private render.</p>
            </div>
            <p class="podcast-admin__pill">Private media</p>
          </div>
          <form class="podcast-admin__form" data-podcast-clip-library-filters>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select name="episodeId">
                  <option value="">All episodes</option>
                </select>
              </label>
              <label>Format
                <select name="aspectRatio">
                  <option value="">All formats</option>
                  <option value="9:16">Vertical · 9:16</option>
                  <option value="1:1">Square · 1:1</option>
                  <option value="16:9">Landscape · 16:9</option>
                </select>
              </label>
              <label>Render state
                <select name="renderStatus">
                  <option value="ready">Ready</option>
                  <option value="queued">Queued</option>
                  <option value="rendering">Rendering</option>
                  <option value="failed">Failed</option>
                  <option value="all">All states</option>
                </select>
              </label>
            </div>
            <button class="btn btn-outline-light" type="submit">Refresh library</button>
            <p class="podcast-admin__status" data-podcast-clip-library-status role="status" aria-live="polite"></p>
          </form>
          <div class="podcast-admin__clip-list" data-podcast-clip-library></div>
          <form class="podcast-admin__form" data-podcast-clip-youtube-form hidden>
            <div class="podcast-admin__panel-heading">
              <div>
                <h3>Controlled YouTube test</h3>
                <p data-podcast-clip-youtube-meta></p>
              </div>
              <p class="podcast-admin__pill">Never public</p>
            </div>
            <div class="podcast-admin__callout">
              <p>Preparing a draft cannot upload. Approval requires a recently authenticated super-admin; dry-run is the default, and a real private/unlisted upload additionally requires the explicit staging controlled-test gate.</p>
            </div>
            <div class="podcast-admin__field-grid">
              <label>Video title
                <input name="title" maxlength="100" required>
              </label>
              <label>Visibility
                <select name="privacyStatus">
                  <option value="unlisted">Unlisted</option>
                  <option value="private">Private</option>
                </select>
              </label>
              <label class="podcast-admin__field-wide">Description
                <textarea name="description" maxlength="5000" rows="5"></textarea>
              </label>
              <label class="podcast-admin__field-wide">Confirm exact channel URL
                <input name="confirmChannelUrl" type="url" inputmode="url" required>
              </label>
            </div>
            <div class="podcast-admin__clip-actions">
              <button class="btn btn-outline-light" type="submit" data-podcast-clip-youtube-save>Prepare draft</button>
              <button class="btn btn-danger" type="button" data-podcast-clip-youtube-approve hidden>Approve controlled test</button>
              <button class="btn btn-outline-light" type="button" data-podcast-clip-youtube-close>Close</button>
            </div>
            <p class="podcast-admin__status" data-podcast-clip-youtube-status role="status" aria-live="polite"></p>
          </form>
          <form class="podcast-admin__form" data-podcast-marketing-link-form>
            <div class="podcast-admin__panel-heading">
              <div>
                <h3>Canonical share kit</h3>
                <p>Build a Pool-style tagged show link and downloadable QR assets locally in this browser.</p>
              </div>
              <p class="podcast-admin__pill">No server writes</p>
            </div>
            <div class="podcast-admin__field-grid podcast-admin__field-grid--three">
              <label>Source
                <input name="source" maxlength="160" value="podcast">
              </label>
              <label>Medium
                <input name="medium" maxlength="160" value="owned">
              </label>
              <label>Campaign
                <input name="campaign" maxlength="160">
              </label>
              <label>Content
                <input name="content" maxlength="160" placeholder="launch-card">
              </label>
              <label>Referral
                <input name="ref" maxlength="64" placeholder="partner-name">
              </label>
              <label class="podcast-admin__field-wide">Tagged canonical URL
                <input name="taggedUrl" type="url" readonly>
              </label>
            </div>
            <div class="podcast-admin__marketing-preview">
              <div data-podcast-marketing-qr aria-live="polite"></div>
              <div>
                <p class="podcast-admin__pill">Share preview</p>
                <h4 data-podcast-marketing-preview-title></h4>
                <p data-podcast-marketing-preview-url></p>
              </div>
            </div>
            <div class="podcast-admin__clip-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-marketing-copy>Copy link</button>
              <button class="btn btn-outline-light" type="button" data-podcast-marketing-share>Share</button>
              <button class="btn btn-outline-light" type="button" data-podcast-marketing-qr-png>Download QR PNG</button>
              <button class="btn btn-outline-light" type="button" data-podcast-marketing-qr-svg>Download QR SVG</button>
            </div>
            <p class="podcast-admin__status" data-podcast-marketing-link-status role="status" aria-live="polite"></p>
          </form>

          <form class="podcast-admin__form" data-podcast-announcement-form>
            <div class="podcast-admin__panel-heading">
              <div>
                <h3>Episode announcement review</h3>
                <p>Compose with the shared Pool/Store editor and review the exact, consented audience projection.</p>
              </div>
              <p class="podcast-admin__pill">Review only</p>
            </div>
            <div class="podcast-admin__callout">
              <p>This checkpoint has no send route. It cannot call Resend. Eligibility requires an explicit show-level opt-in in the listener account plus an active subscription.</p>
            </div>
            <div class="podcast-admin__field-grid">
              <label>Language
                <select name="language">
                  <option value="es">Español</option>
                  <option value="en">English</option>
                </select>
              </label>
              <label>Subject
                <input name="subject" maxlength="160" required>
              </label>
              <label class="podcast-admin__field-wide">Heading
                <input name="heading" maxlength="160">
              </label>
              <div class="podcast-admin__field-wide">
                <span class="podcast-admin__field-label">Announcement content</span>
                <div data-podcast-announcement-editor></div>
              </div>
              <label>CTA label
                <input name="ctaLabel" maxlength="80">
              </label>
              <label>CTA URL
                <input name="ctaUrl" type="url" maxlength="2048">
              </label>
            </div>
            <button class="btn btn-danger" type="submit">Run audience dry-run</button>
            <p class="podcast-admin__status" data-podcast-announcement-status role="status" aria-live="polite"></p>
            <div class="podcast-admin__announcement-review" data-podcast-announcement-review aria-live="polite"></div>
          </form>
        </section>

        <section id="podcast-panel-sponsors" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-sponsors" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Sponsor decision preview</h2>
              <p>Evaluate Dust Wave promos and directly sold sponsors against a specific listening context.</p>
            </div>
            <p class="podcast-admin__pill">Preview only</p>
          </div>
          <div class="podcast-admin__callout">
            <p>This tool reads current targeting and media-readiness state. It cannot insert an ad, create an impression, or change the public episode file.</p>
          </div>
          <form class="podcast-admin__form" data-podcast-campaign-form>
            <h3>New campaign draft</h3>
            <p>Campaigns remain unapproved until compatible creative audio is validated. Creating or editing a campaign cannot enable playback.</p>
            <div class="podcast-admin__field-grid">
              <label>Campaign name
                <input name="name" required>
              </label>
              <label>Type
                <select name="campaignType">
                  <option value="house">Dust Wave promo</option>
                  <option value="direct">Direct sponsor</option>
                </select>
              </label>
              <label data-direct-sponsor-field hidden>Sponsor name
                <input name="sponsorName">
              </label>
              <label data-direct-sponsor-field hidden>Sponsor website
                <input name="sponsorWebsiteUrl" type="url" inputmode="url">
              </label>
              <label>Starts
                <input name="startsAt" type="datetime-local" required>
              </label>
              <label>Ends
                <input name="endsAt" type="datetime-local">
              </label>
              <label>Episode target
                <select name="episodeId">
                  <option value="">All episodes in this show</option>
                </select>
              </label>
              <label>Position
                <select name="position">
                  <option value="">All positions</option>
                  <option value="pre">Pre-roll</option>
                  <option value="mid">Mid-roll</option>
                  <option value="post">Post-roll</option>
                </select>
              </label>
              <label>Podcast app
                <select name="appName">
                  <option value="">All apps</option>
                  <option value="apple_podcasts">Apple Podcasts</option>
                  <option value="spotify">Spotify</option>
                  <option value="pocket_casts">Pocket Casts</option>
                  <option value="overcast">Overcast</option>
                  <option value="podcast_addict">Podcast Addict</option>
                  <option value="browser">Dust Wave web player</option>
                </select>
              </label>
              <label>Device
                <select name="deviceType">
                  <option value="">All devices</option>
                  <option value="mobile">Mobile</option>
                  <option value="tablet">Tablet</option>
                  <option value="desktop">Desktop</option>
                  <option value="smart_speaker">Smart speaker</option>
                  <option value="unknown">Unknown</option>
                </select>
              </label>
              <label>Priority
                <input name="priority" type="number" min="-1000" max="1000" value="0">
              </label>
              <label>Pacing
                <select name="pacingStrategy">
                  <option value="even">Even</option>
                  <option value="asap">As soon as possible</option>
                  <option value="manual">Manual</option>
                </select>
              </label>
              <label>Hard impression cap
                <input name="impressionCap" type="number" min="1">
              </label>
              <label>Qualified-impression goal
                <input name="qualifiedImpressionGoal" type="number" min="1">
              </label>
              <label data-direct-sponsor-field hidden>Billing model
                <select name="billingModel">
                  <option value="flat_fee">Flat fee</option>
                  <option value="cpm">CPM</option>
                </select>
              </label>
              <label data-direct-sponsor-field hidden>Contract amount (USD)
                <input name="contractAmount" type="number" min="0" step="0.01">
              </label>
              <label data-direct-sponsor-field hidden>CPM (USD)
                <input name="cpm" type="number" min="0" step="0.01">
              </label>
            </div>
            <button class="btn btn-outline-light" type="submit">Create draft campaign</button>
            <p class="podcast-admin__status" data-podcast-campaign-status role="status" aria-live="polite"></p>
          </form>
          <div class="podcast-admin__campaign-list" data-podcast-campaign-list></div>

          <form class="podcast-admin__form" data-podcast-creative-form hidden>
            <h3>Creative audio</h3>
            <p>Upload one MP3, verify every frame against the launch stream profile, and return the campaign to draft for review.</p>
            <div class="podcast-admin__field-grid">
              <label>Campaign
                <select name="campaignId" required></select>
              </label>
              <label>Creative name
                <input name="name" required>
              </label>
              <label>Declared duration (seconds)
                <input name="durationSeconds" type="number" min="1" max="600" required>
              </label>
              <label>Selection weight
                <input name="weight" type="number" min="1" max="1000000" value="1" required>
              </label>
            </div>
            <label>MP3 file
              <input name="audio" type="file" accept=".mp3,audio/mpeg" required>
            </label>
            <progress data-podcast-creative-progress max="3" value="0" hidden></progress>
            <button class="btn btn-outline-light" type="submit">Upload and validate creative</button>
            <p class="podcast-admin__status" data-podcast-creative-status role="status" aria-live="polite"></p>
          </form>

          <form class="podcast-admin__form" data-podcast-sponsor-preview-form>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select name="episodeId" required></select>
              </label>
              <label>Position
                <select name="position">
                  <option value="pre">Pre-roll</option>
                  <option value="mid" selected>Mid-roll</option>
                  <option value="post">Post-roll</option>
                </select>
              </label>
              <label>Podcast app
                <select name="appName">
                  <option value="apple_podcasts">Apple Podcasts</option>
                  <option value="spotify">Spotify</option>
                  <option value="pocket_casts">Pocket Casts</option>
                  <option value="overcast">Overcast</option>
                  <option value="podcast_addict">Podcast Addict</option>
                  <option value="browser">Dust Wave web player</option>
                  <option value="unknown">Unknown</option>
                </select>
              </label>
              <label>Device
                <select name="deviceType">
                  <option value="mobile">Mobile</option>
                  <option value="tablet">Tablet</option>
                  <option value="desktop">Desktop</option>
                  <option value="smart_speaker">Smart speaker</option>
                  <option value="unknown">Unknown</option>
                </select>
              </label>
              <label>Stream profile
                <input name="streamProfile" value="mp3-44100-stereo-cbr128-frame-v1" required>
              </label>
              <label>Decision time
                <input name="at" type="datetime-local">
              </label>
            </div>
            <button class="btn btn-danger" type="submit">Preview decision</button>
            <p class="podcast-admin__status" data-podcast-sponsor-status role="status" aria-live="polite"></p>
          </form>
          <div data-podcast-sponsor-preview-result aria-live="polite"></div>
        </section>

        <section id="podcast-panel-analytics" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-analytics" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Analytics</h2>
              <p>Methodology-versioned first-party evidence for <strong data-podcast-reconciliation-show>this show</strong>.</p>
            </div>
            <button class="btn btn-outline-light" type="button" data-podcast-reconciliation-refresh>Refresh</button>
          </div>
          <div class="podcast-admin__metric-grid">
            <article><strong>—</strong><span>Qualified downloads</span></article>
            <article><strong>—</strong><span>Engaged plays</span></article>
            <article><strong>—</strong><span>Premium listeners</span></article>
            <article><strong data-podcast-qualified-sponsor-deliveries>—</strong><span>Qualified sponsor deliveries</span></article>
            <article><strong data-podcast-reconciliation-differences>—</strong><span>Counter discrepancies</span></article>
            <article><strong data-podcast-campaigns-at-cap>—</strong><span>Campaigns at cap</span></article>
          </div>
          <div class="podcast-admin__callout" data-podcast-reconciliation-methodology>
            <p>Download, engagement, and premium-listener metrics remain blank—not zero—until their first-party observation methods ship.</p>
            <p>Qualified sponsor delivery counts only a completed decision slot after a trusted observer confirms delivery of the full snapshotted creative byte threshold.</p>
          </div>
          <p class="podcast-admin__status" data-podcast-reconciliation-status role="status" aria-live="polite"></p>
          <div data-podcast-reconciliation></div>
        </section>

        <section id="podcast-panel-billing" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-billing" hidden>
          <h2>Premium readiness</h2>
          <div data-podcast-billing></div>
        </section>
      </div>
    </div>
  </section>
</div>
