---
layout: layouts/podcast-admin.njk
title: Podcast Admin — Dust Wave
description: Private Dust Wave Podcast publishing workbench.
language: en
permalink: admin/podcasts/index.html
---

<div
  class="podcast-admin__container"
  data-podcast-admin
  data-api-origin="{{ podcastAdmin.apiOrigin }}"
  data-turnstile-site-key="{{ podcastAdmin.turnstileSiteKey }}">
  <a class="visually-hidden-focusable" href="#podcast-admin-content">Skip to Podcast admin content</a>

  <header class="podcast-admin__header">
    <div>
      <p class="podcast-admin__eyebrow">Dust Wave Admin</p>
      <h1>Podcasts</h1>
      <p>Multi-show publishing, media, distribution, premium, and launch readiness.</p>
    </div>
    <button class="btn btn-outline-light" type="button" data-podcast-logout hidden>Log out</button>
  </header>

  <p class="podcast-admin__status" data-podcast-global-status role="status" aria-live="polite"></p>

  <section class="podcast-admin__auth" data-podcast-auth aria-labelledby="podcast-login-title">
    <h2 id="podcast-login-title">Sign in</h2>
    <p>We’ll email a private, single-use link. / Te enviaremos un enlace privado de un solo uso.</p>
    <form data-podcast-login-form>
      <label for="podcast-admin-email">Email</label>
      <div class="podcast-admin__inline-form">
        <input id="podcast-admin-email" name="email" type="email" autocomplete="email" required>
        <button class="btn btn-danger" type="submit">Send link</button>
      </div>
      {% if podcastAdmin.turnstileSiteKey %}
      <div id="podcast-turnstile" class="podcast-admin__turnstile"></div>
      {% endif %}
    </form>
    <p class="podcast-admin__status" data-podcast-auth-status role="status" aria-live="polite"></p>
  </section>

  <section class="podcast-admin__app" data-podcast-app hidden>
    <p class="podcast-admin__session" data-podcast-session-summary></p>

    <div class="podcast-admin__tabs" data-podcast-tabs>
      <div class="podcast-admin__tab-list" role="tablist" aria-label="Podcast administration">
        <button id="podcast-tab-overview" type="button" role="tab" data-tab="overview" aria-controls="podcast-panel-overview">Overview</button>
        <button id="podcast-tab-episodes" type="button" role="tab" data-tab="episodes" aria-controls="podcast-panel-episodes">Episodes</button>
        <button id="podcast-tab-production" type="button" role="tab" data-tab="production" aria-controls="podcast-panel-production">Production</button>
        <button id="podcast-tab-distribution" type="button" role="tab" data-tab="distribution" aria-controls="podcast-panel-distribution">Distribution</button>
        <button id="podcast-tab-marketing" type="button" role="tab" data-tab="marketing" aria-controls="podcast-panel-marketing">Marketing</button>
        <button id="podcast-tab-sponsors" type="button" role="tab" data-tab="sponsors" aria-controls="podcast-panel-sponsors">Sponsors</button>
        <button id="podcast-tab-analytics" type="button" role="tab" data-tab="analytics" aria-controls="podcast-panel-analytics">Analytics</button>
        <button id="podcast-tab-billing" type="button" role="tab" data-tab="billing" aria-controls="podcast-panel-billing">Premium</button>
      </div>

      <div id="podcast-admin-content">
        <section id="podcast-panel-overview" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-overview">
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Shows</h2>
              <p>Single-show launch interface; the API and data model support more shows.</p>
            </div>
            <button class="btn btn-outline-light" type="button" data-podcast-refresh>Refresh</button>
          </div>
          <div class="podcast-admin__cards" data-podcast-show-cards></div>

          <form class="podcast-admin__form podcast-admin__form--settings" data-podcast-show-form hidden>
            <h3>Show settings</h3>
            <label for="podcast-show-title">Title</label>
            <input id="podcast-show-title" name="title" required>
            <label for="podcast-show-description">Descripción (ES)</label>
            <textarea id="podcast-show-description" name="description" rows="4"></textarea>
            <label for="podcast-show-description-en">Description (EN)</label>
            <textarea id="podcast-show-description-en" name="descriptionEn" rows="4"></textarea>
            <div class="podcast-admin__field-grid">
              <label>Early access days
                <input name="earlyAccessDays" type="number" min="0" max="365">
              </label>
              <label>YouTube channel
                <input name="youtubeChannelUrl" type="url">
              </label>
            </div>
            <label class="podcast-admin__checkbox">
              <input name="premiumEnabled" type="checkbox"> Premium enabled
            </label>
            <label class="podcast-admin__checkbox">
              <input name="freeMiniEpisodeEnabled" type="checkbox"> One free mini-episode enabled
            </label>
            <button class="btn btn-danger" type="submit">Save show settings</button>
            <p class="podcast-admin__status" data-podcast-show-status role="status" aria-live="polite"></p>
          </form>
        </section>

        <section id="podcast-panel-episodes" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-episodes" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Episodes</h2>
              <p>Create the canonical episode record, attach delivery media, then publish one reviewed revision.</p>
            </div>
            <select data-podcast-show-select aria-label="Show"></select>
          </div>

          <form class="podcast-admin__form" data-podcast-episode-form>
            <h3>New episode</h3>
            <div class="podcast-admin__field-grid">
              <label>Title
                <input name="title" required>
              </label>
              <label>URL slug
                <input name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required>
              </label>
            </div>
            <label>Summary
              <textarea name="summary" rows="3" required></textarea>
            </label>
            <label>Episode notes</label>
            <div class="podcast-admin__editor" data-podcast-notes-editor></div>
            <div class="podcast-admin__field-grid podcast-admin__field-grid--three">
              <label>Access
                <select name="access">
                  <option value="public">Public</option>
                  <option value="early_access">Early access</option>
                  <option value="premium_bonus">Premium bonus</option>
                  <option value="free_mini">Free mini-episode</option>
                </select>
              </label>
              <label>Source language
                <select name="sourceLanguage" required>
                  <option value="es">Español</option>
                  <option value="en">English</option>
                </select>
              </label>
              <label>Premium release
                <input name="premiumAt" type="datetime-local">
              </label>
              <label>Public release
                <input name="publicAt" type="datetime-local">
              </label>
            </div>
            <button class="btn btn-danger" type="submit">Create draft</button>
            <p class="podcast-admin__status" data-podcast-episode-status role="status" aria-live="polite"></p>
          </form>

          <form class="podcast-admin__form" data-podcast-upload-form>
            <h3>Attach media</h3>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select name="episodeId" required></select>
              </label>
              <label>Media role
                <select name="kind">
                  <option value="delivery_audio">Delivery audio</option>
                  <option value="source_audio">Source audio</option>
                  <option value="video_source">Video source</option>
                </select>
              </label>
            </div>
            <label>File
              <input name="media" type="file" accept="audio/*,video/mp4,video/quicktime,video/webm" required>
            </label>
            <progress data-podcast-upload-progress max="100" value="0" hidden></progress>
            <button class="btn btn-outline-light" type="submit">Upload media</button>
            <p class="podcast-admin__status" data-podcast-upload-status role="status" aria-live="polite"></p>
          </form>

          <form class="podcast-admin__form" data-podcast-ad-plan-form hidden>
            <h3>Dynamic-ad markers and program segments</h3>
            <p>Submit producer marker intent, process one normalized MP3 into frame-safe program segments, then review the evidence before approval. Approval does not enable request-time ads.</p>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select name="episodeId" required></select>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="preRoll" type="checkbox"> Pre-roll
              </label>
              <label class="podcast-admin__checkbox">
                <input name="midRoll" type="checkbox"> Mid-roll
              </label>
              <label>Mid-roll time (seconds)
                <input name="midRollSeconds" type="number" min="1" step="1" disabled>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="postRoll" type="checkbox"> Post-roll
              </label>
            </div>
            <button class="btn btn-outline-light" type="submit">Submit frame-safe plan</button>
            <p class="podcast-admin__status" data-podcast-ad-plan-status role="status" aria-live="polite"></p>
          </form>
          <div data-podcast-ad-plan-result aria-live="polite"></div>

          <div class="podcast-admin__episode-list" data-podcast-episode-list></div>
        </section>

        <section id="podcast-panel-production" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-production" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>Source audio quality</h2>
              <p>Measure the immutable source before enhancement or delivery rendering. Reports compare mono/stereo loudness, true peak, clipping, offset, channel balance, and silence against the show policy.</p>
            </div>
            <p class="podcast-admin__pill">Measured · non-destructive</p>
          </div>
          <div class="podcast-admin__callout">
            <p>Queueing snapshots the completed private source, show policy, R2 ETag, and processor manifest. The owner-controlled staging workflow fully decodes the source and returns signed evidence; it never overwrites audio or publishes an episode.</p>
            <p data-podcast-audio-qc-policy-summary aria-live="polite">Loading the show measurement policy…</p>
          </div>
          <form class="podcast-admin__form podcast-admin__audio-qc-policy" data-podcast-audio-qc-policy-form hidden>
            <h3>Show measurement policy</h3>
            <p>Admin and Super-admin changes apply only to future QC runs. Existing reports keep their snapshotted policy revision.</p>
            <div class="podcast-admin__field-grid">
              <label>Mono target (LUFS)
                <input name="monoIntegratedLufs" type="number" min="-40" max="-5" step="0.1" required>
              </label>
              <label>Stereo target (LUFS)
                <input name="stereoIntegratedLufs" type="number" min="-40" max="-5" step="0.1" required>
              </label>
              <label>Loudness tolerance (LU)
                <input name="integratedLufsTolerance" type="number" min="0.1" max="10" step="0.1" required>
              </label>
              <label>Maximum true peak (dBTP)
                <input name="maximumTruePeakDbtp" type="number" min="-12" max="0" step="0.1" required>
              </label>
              <label>Maximum DC offset
                <input name="maximumDcOffset" type="number" min="0" max="0.25" step="0.001" required>
              </label>
              <label>Maximum channel imbalance (LU)
                <input name="maximumChannelImbalanceLu" type="number" min="0" max="24" step="0.1" required>
              </label>
              <label>Maximum leading silence (ms)
                <input name="maximumLeadingSilenceMs" type="number" min="0" max="60000" step="1" required>
              </label>
              <label>Maximum trailing silence (ms)
                <input name="maximumTrailingSilenceMs" type="number" min="0" max="60000" step="1" required>
              </label>
              <label>Maximum internal silence (ms)
                <input name="maximumInternalSilenceMs" type="number" min="0" max="120000" step="1" required>
              </label>
              <label>Silence detector threshold (dB)
                <input name="silenceThresholdDb" type="number" min="-100" max="-10" step="0.1" required>
              </label>
            </div>
            <button class="btn btn-outline-light" type="submit">Save future-run policy</button>
            <p class="podcast-admin__status" data-podcast-audio-qc-policy-status role="status" aria-live="polite"></p>
          </form>
          <section class="podcast-admin__audio-qc" data-podcast-audio-qc aria-label="Source audio quality">
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select data-podcast-audio-qc-episode required></select>
              </label>
            </div>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-danger" type="button" data-podcast-audio-qc-queue>Queue measured QC</button>
              <button class="btn btn-outline-light" type="button" data-podcast-audio-qc-refresh>Refresh report</button>
            </div>
            <p class="podcast-admin__transcript-meta" data-podcast-audio-qc-summary aria-live="polite">Choose an episode with completed source audio.</p>
            <div class="podcast-admin__audio-qc-results" data-podcast-audio-qc-results></div>
            <p class="podcast-admin__status" data-podcast-audio-qc-status role="status" aria-live="polite"></p>
          </section>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
              <h2>Working master and A/B preview</h2>
              <p>Approve one byte-exact, zero-blocker source as the episode’s working master. Compare private enhancement presets without changing source or delivery audio.</p>
            </div>
            <p class="podcast-admin__pill">Explicit · reversible</p>
          </div>
          <div class="podcast-admin__callout">
            <p>An enhancement preview is never a master. A processed master will require a full-length render and a new quality-control pass. Replacing an approved master makes transcript, chapter, clip, and readiness approvals stale.</p>
          </div>
          <section class="podcast-admin__audio-master" data-podcast-audio-master aria-label="Working audio master">
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select data-podcast-audio-master-episode required></select>
              </label>
            </div>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-audio-master-refresh>Refresh master state</button>
            </div>
            <p class="podcast-admin__transcript-meta" data-podcast-audio-master-summary aria-live="polite">Choose an episode with a successful source-audio QC run.</p>
            <div class="podcast-admin__audio-master-current" data-podcast-audio-master-current></div>

            <form class="podcast-admin__form podcast-admin__audio-master-approval" data-podcast-audio-master-approval hidden>
              <h3>Approve exact source</h3>
              <p>Super-admin only. The current source object, SHA-256, policy revision, and QC report are recorded as immutable evidence.</p>
              <label>Approval reason
                <textarea name="approvalReason" rows="3" maxlength="500" required></textarea>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="acknowledgeExactSource" type="checkbox" required>
                I reviewed the current zero-blocker QC evidence and approve these exact source bytes.
              </label>
              <button class="btn btn-danger" type="submit">Approve working master</button>
              <p class="podcast-admin__status" data-podcast-audio-master-approval-status role="status" aria-live="polite"></p>
            </form>

            <form class="podcast-admin__form podcast-admin__audio-enhancement-form" data-podcast-audio-enhancement-form hidden>
              <h3>Private enhancement comparison</h3>
              <p>Producer and above. Both previews use the same MP3 profile and remain private; queueing never approves or publishes audio.</p>
              <div class="podcast-admin__field-grid podcast-admin__field-grid--three">
                <label>Preset
                  <select name="presetId" required></select>
                </label>
                <label>Start (seconds)
                  <input name="previewStartSeconds" type="number" min="0" step="0.1" value="0" required>
                </label>
                <label>Length (seconds)
                  <input name="previewDurationSeconds" type="number" min="5" max="90" step="1" value="45" required>
                </label>
              </div>
              <button class="btn btn-outline-light" type="submit">Queue private A/B preview</button>
              <p class="podcast-admin__status" data-podcast-audio-enhancement-status role="status" aria-live="polite"></p>
            </form>

            <div class="podcast-admin__audio-enhancement-results" data-podcast-audio-enhancement-results></div>
          </section>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
              <h2>Transcript review</h2>
              <p>Edit bilingual timed cues with the shared Pool/Store editor, confirm public speaker labels, and approve a versioned revision.</p>
            </div>
            <p class="podcast-admin__pill">Word timing gated</p>
          </div>
          <div class="podcast-admin__callout">
            <p>Cue editing does not invent word timing. Word-linked navigation and word-accurate clip cuts remain unavailable until a matching English/Spanish alignment revision passes the launch quality gate.</p>
          </div>
          <div class="podcast-admin__form" data-podcast-transcription-workbench>
            <div class="podcast-admin__panel-heading podcast-admin__section-heading">
              <div>
                <h3>Source-language transcription</h3>
                <p>Run the approved working master through the pinned Cloudflare Workers AI adapter. Large sources first use the checksummed, silence-aware staging chunk workflow; then every segment-timed draft returns to the same editor below.</p>
              </div>
              <div class="podcast-admin__transcript-actions">
                <button class="btn btn-outline-light" type="button" data-podcast-transcription-refresh>Refresh jobs</button>
                <button class="btn btn-danger" type="button" data-podcast-transcription-queue>Queue transcript</button>
              </div>
            </div>
            <p class="podcast-admin__transcript-meta" data-podcast-transcription-summary aria-live="polite">Choose an episode with an approved working master.</p>
            <p class="podcast-admin__status" data-podcast-transcription-status role="status" aria-live="polite"></p>
            <div class="podcast-admin__audio-enhancement-results" data-podcast-transcription-jobs></div>
          </div>
          <div class="podcast-admin__form" data-podcast-transcript-workbench>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select data-podcast-transcript-episode required></select>
              </label>
              <label>Transcript language
                <select data-podcast-transcript-language>
                  <option value="es">Español</option>
                  <option value="en">English</option>
                </select>
              </label>
            </div>
            <div class="podcast-admin__transcript-meta" data-podcast-transcript-meta aria-live="polite"></div>
            <div class="podcast-admin__transcript-cues" data-podcast-transcript-cues></div>
            <nav class="podcast-admin__transcript-pages" data-podcast-transcript-pages aria-label="Transcript cue pages" hidden>
              <button class="btn btn-outline-light" type="button" data-podcast-transcript-previous>Previous cues</button>
              <span data-podcast-transcript-page aria-live="polite"></span>
              <button class="btn btn-outline-light" type="button" data-podcast-transcript-next>Next cues</button>
            </nav>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-transcript-add>Add cue</button>
              <button class="btn btn-danger" type="button" data-podcast-transcript-save>Save review draft</button>
              <button class="btn btn-outline-light" type="button" data-podcast-transcript-approve>Approve revision</button>
            </div>
            <p class="podcast-admin__status" data-podcast-transcript-status role="status" aria-live="polite"></p>
            <section class="podcast-admin__alignment" data-podcast-alignment aria-label="English and Spanish word alignment">
              <div class="podcast-admin__panel-heading podcast-admin__section-heading">
                <div>
                  <h3>English/Spanish word alignment</h3>
                  <p>Bind the approved transcript and working-master bytes to one pinned, normalized alignment run. Results remain private and require human review plus a matching bilingual benchmark before word controls unlock.</p>
                </div>
                <p class="podcast-admin__pill">H1 quality gate</p>
              </div>
              <div class="podcast-admin__field-grid">
                <label>Alignment adapter
                  <select data-podcast-alignment-adapter>
                    <option value="whisperx">WhisperX 3.8.6</option>
                    <option value="stable-ts">stable-ts 2.19.1 fallback</option>
                  </select>
                </label>
              </div>
              <div class="podcast-admin__transcript-actions">
                <button class="btn btn-outline-light" type="button" data-podcast-alignment-refresh>Refresh alignments</button>
                <button class="btn btn-danger" type="button" data-podcast-alignment-queue>Queue exact alignment</button>
              </div>
              <p class="podcast-admin__transcript-meta" data-podcast-alignment-summary aria-live="polite">Approve this transcript revision and a working master before alignment.</p>
              <p class="podcast-admin__status" data-podcast-alignment-status role="status" aria-live="polite"></p>
              <div class="podcast-admin__audio-enhancement-results" data-podcast-alignment-jobs></div>
            </section>
          </div>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
              <h2>Chapter review</h2>
              <p>Build a bilingual-capable table of contents for the existing player and Podcasting 2.0 feeds, then approve one immutable revision.</p>
            </div>
            <p class="podcast-admin__pill">Versioned · fail closed</p>
          </div>
          <div class="podcast-admin__callout">
            <p>The first chapter starts at 00:00. Titles can be Spanish, English, or paired; optional links and artwork must use HTTPS. Apple recommends concise titles and at least three chapters for longer episodes.</p>
          </div>
          <div class="podcast-admin__form" data-podcast-chapter-workbench>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select data-podcast-chapter-episode required></select>
              </label>
            </div>
            <div class="podcast-admin__transcript-meta" data-podcast-chapter-meta aria-live="polite"></div>
            <div class="podcast-admin__chapter-rows" data-podcast-chapter-rows></div>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-chapter-add>Add chapter</button>
              <button class="btn btn-danger" type="button" data-podcast-chapter-save>Save review draft</button>
              <button class="btn btn-outline-light" type="button" data-podcast-chapter-approve>Approve revision</button>
            </div>
            <p class="podcast-admin__status" data-podcast-chapter-status role="status" aria-live="polite"></p>
          </div>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
              <h2>Production review</h2>
              <p>Attach a plain-text note to an exact audio, transcript, chapter, clip, or ad-plan revision, optionally at a playback instant or range.</p>
            </div>
            <p class="podcast-admin__pill">Exact revision · audit safe</p>
          </div>
          <div class="podcast-admin__callout">
            <p>Open blockers and approval state feed the publication gate. Stale target revisions remain in history and cannot silently become current; the readiness panel always shows whether this environment observes or enforces the gate.</p>
          </div>
          <form class="podcast-admin__form" data-podcast-review-form>
            <div class="podcast-admin__field-grid">
              <label>Episode
                <select name="episodeId" data-podcast-review-episode required></select>
              </label>
              <label>Exact current target
                <select name="target" data-podcast-review-target required></select>
              </label>
              <label>Start in seconds (optional)
                <input name="startsAtSeconds" type="number" min="0" step="0.001">
              </label>
              <label>End in seconds (optional)
                <input name="endsAtSeconds" type="number" min="0" step="0.001">
              </label>
            </div>
            <label>Review note · español / English
              <textarea name="bodyText" rows="4" maxlength="4000" required></textarea>
            </label>
            <div class="podcast-admin__field-grid">
              <label class="podcast-admin__checkbox">
                <input name="blocker" type="checkbox">
                Mark as a release blocker
              </label>
              <label class="podcast-admin__checkbox">
                <input name="assignToSelf" type="checkbox">
                Assign this note to me
              </label>
            </div>
            <button class="btn btn-danger" type="submit">Add review note</button>
            <p class="podcast-admin__status" data-podcast-review-status role="status" aria-live="polite"></p>
          </form>
          <div class="podcast-admin__transcript-meta" data-podcast-review-readiness aria-live="polite"></div>
          <div class="podcast-admin__review-list" data-podcast-review-list></div>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
              <h2>Publication readiness</h2>
              <p>Inspect the immutable snapshot that Publish binds to the legacy checks and the fuller launch dependency graph.</p>
            </div>
            <button class="btn btn-outline-light" type="button" data-podcast-readiness-refresh>Refresh snapshot</button>
          </div>
          <div class="podcast-admin__callout">
            <p>Publish refreshes this snapshot immediately before acting. Enforcement blocks stale or incomplete evidence; only a recently authenticated Admin or Super-admin can record a private, audited reason and explicitly override unresolved candidate blockers.</p>
          </div>
          <section class="podcast-admin__readiness" data-podcast-publication-readiness aria-label="Publication readiness snapshot">
