              <label>{{ workbench.analytics.range }}
                <select name="analyticsRange" data-podcast-analytics-range>
                  <option value="7">{{ workbench.analytics.sevenDays }}</option>
                  <option value="30" selected>{{ workbench.analytics.thirtyDays }}</option>
                  <option value="90">{{ workbench.analytics.ninetyDays }}</option>
                </select>
              </label>
              <button class="btn btn-outline-light" type="button" data-podcast-analytics-refresh>{{ workbench.common.refresh }}</button>
              <button class="btn btn-outline-light" type="button" data-podcast-analytics-export>{{ workbench.analytics.export }}</button>
            </div>
          </div>
          <div class="podcast-admin__metric-grid">
            <article><strong data-podcast-qualified-downloads>—</strong><span>{{ workbench.analytics.qualifiedDownloads }}</span></article>
            <article><strong data-podcast-engaged-plays>—</strong><span>{{ workbench.analytics.engagedPlays }}</span></article>
            <article><strong data-podcast-premium-listeners>—</strong><span>{{ workbench.analytics.premiumListeners }}</span></article>
            <article><strong data-podcast-qualified-sponsor-deliveries>—</strong><span>{{ workbench.analytics.qualifiedSponsorDeliveries }}</span></article>
            <article><strong data-podcast-reconciliation-differences>—</strong><span>{{ workbench.analytics.counterDiscrepancies }}</span></article>
            <article><strong data-podcast-campaigns-at-cap>—</strong><span>{{ workbench.analytics.campaignsAtCap }}</span></article>
          </div>
          <div class="podcast-admin__callout">
            <p data-podcast-analytics-methodology>{{ workbench.analytics.methodology }}</p>
            <p>{{ workbench.analytics.privacy }}</p>
            <p>{{ workbench.analytics.sponsorMethodology }}</p>
          </div>
          <p class="podcast-admin__status" data-podcast-analytics-status role="status" aria-live="polite"></p>
          <section class="podcast-admin__analytics-section" aria-labelledby="podcast-analytics-trend-heading">
            <h3 id="podcast-analytics-trend-heading">{{ workbench.analytics.dailyTrend }}</h3>
            <div class="podcast-admin__analytics-trend-region" data-podcast-analytics-trend></div>
          </section>
          <section class="podcast-admin__analytics-section" aria-labelledby="podcast-analytics-episodes-heading">
            <h3 id="podcast-analytics-episodes-heading">{{ workbench.analytics.topEpisodes }}</h3>
            <div data-podcast-analytics-episodes></div>
          </section>
          <section class="podcast-admin__analytics-section" aria-labelledby="podcast-analytics-completion-heading">
            <h3 id="podcast-analytics-completion-heading">{{ workbench.analytics.webPlayerCompletion }}</h3>
            <p>{{ workbench.analytics.webPlayerCompletionIntro }}</p>
            <div data-podcast-web-player-completion></div>
          </section>
          <section class="podcast-admin__analytics-section" aria-labelledby="podcast-analytics-breakdowns-heading">
            <h3 id="podcast-analytics-breakdowns-heading">{{ workbench.analytics.breakdowns }}</h3>
            <div class="podcast-admin__analytics-breakdowns">
              <div data-podcast-analytics-apps></div>
              <div data-podcast-analytics-devices></div>
              <div data-podcast-analytics-countries></div>
            </div>
          </section>
          <section class="podcast-admin__analytics-section" aria-labelledby="podcast-analytics-sponsors-heading">
            <div class="podcast-admin__analytics-section-heading">
              <h3 id="podcast-analytics-sponsors-heading">{{ workbench.analytics.sponsorReconciliation }}</h3>
              <button class="btn btn-outline-light" type="button" data-podcast-reconciliation-refresh>{{ workbench.analytics.refreshSponsors }}</button>
            </div>
          </section>
          <p class="podcast-admin__status" data-podcast-reconciliation-status role="status" aria-live="polite"></p>
          <div data-podcast-reconciliation></div>
        </section>

        <section id="podcast-panel-subscribers" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-subscribers" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>{{ i18n | t(language, "podcast.admin.subscribers.heading") }}</h2>
              <p>{{ i18n | t(language, "podcast.admin.subscribers.intro") }}</p>
            </div>
            <div class="podcast-admin__billing-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-subscribers-refresh>{{ i18n | t(language, "podcast.admin.subscribers.refresh") }}</button>
              <button class="btn btn-outline-light" type="button" data-podcast-subscribers-export>{{ i18n | t(language, "podcast.admin.subscribers.export") }}</button>
            </div>
          </div>
          <form class="podcast-admin__distribution-filter" data-podcast-subscribers-filters>
            <label>{{ i18n | t(language, "podcast.admin.subscribers.status") }}
              <select name="status">
                <option value="all">{{ i18n | t(language, "podcast.admin.subscribers.allStatuses") }}</option>
                <option value="active">{{ i18n | t(language, "podcast.admin.subscribers.active") }}</option>
                <option value="past_due">{{ i18n | t(language, "podcast.admin.subscribers.pastDue") }}</option>
                <option value="paused">{{ i18n | t(language, "podcast.admin.subscribers.paused") }}</option>
                <option value="pending">{{ i18n | t(language, "podcast.admin.subscribers.pending") }}</option>
                <option value="canceled">{{ i18n | t(language, "podcast.admin.subscribers.canceled") }}</option>
                <option value="expired">{{ i18n | t(language, "podcast.admin.subscribers.expired") }}</option>
              </select>
            </label>
            <label>{{ i18n | t(language, "podcast.admin.subscribers.source") }}
              <select name="provider">
                <option value="all">{{ i18n | t(language, "podcast.admin.subscribers.allSources") }}</option>
                <option value="stripe">Stripe</option>
                <option value="pool">Pool</option>
                <option value="manual">{{ i18n | t(language, "podcast.admin.subscribers.manual") }}</option>
              </select>
            </label>
          </form>
          <div class="podcast-admin__callout">
            <p>{{ i18n | t(language, "podcast.admin.subscribers.privacy") }}</p>
          </div>
          <p class="podcast-admin__status" data-podcast-subscribers-status role="status" aria-live="polite"></p>
          <div data-podcast-subscribers></div>
          <button class="btn btn-outline-light podcast-admin__load-more" type="button" data-podcast-subscribers-more hidden>{{ i18n | t(language, "podcast.admin.subscribers.more") }}</button>
        </section>

        <section id="podcast-panel-billing" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-billing" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>{{ i18n | t(language, "podcast.admin.billing.heading") }}</h2>
              <p>{{ i18n | t(language, "podcast.admin.billing.intro") }}</p>
            </div>
            <div class="podcast-admin__billing-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-billing-refresh>{{ i18n | t(language, "podcast.admin.billing.refresh") }}</button>
              <button class="btn btn-outline-light" type="button" data-podcast-billing-export>{{ i18n | t(language, "podcast.admin.billing.export") }}</button>
            </div>
          </div>
          <p class="podcast-admin__status" data-podcast-billing-status role="status" aria-live="polite"></p>
          <div data-podcast-billing></div>
        </section>

        <section id="podcast-panel-settings" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-settings" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>{{ workbench.overview.settings }}</h2>
              <p>{{ workbench.overview.settingsIntro }}</p>
            </div>
            <select name="showId" data-podcast-show-select aria-label="{{ workbench.common.show }}"></select>
          </div>
          <form class="podcast-admin__form podcast-admin__form--settings" data-podcast-show-form hidden>
            <label>{{ workbench.common.title }}
              <input id="podcast-show-title" name="title" autocomplete="off" required>
            </label>
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.overview.primaryLanguage }}
                <select name="language" required>
                  <option value="es">{{ workbench.common.spanish }}</option>
                  <option value="en">{{ workbench.common.english }}</option>
                </select>
              </label>
              <label>{{ workbench.overview.showStatus }}
                <select name="status" required>
                  <option value="coming_soon">{{ workbench.overview.statusComingSoon }}</option>
                  <option value="active">{{ workbench.overview.statusActive }}</option>
                  <option value="archived">{{ workbench.overview.statusArchived }}</option>
                </select>
              </label>
            </div>
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.overview.authorName }}
                <input name="authorName" maxlength="200">
              </label>
              <label>{{ workbench.overview.category }}
                <input name="category" maxlength="200">
              </label>
            </div>
            <label>{{ workbench.overview.descriptionSpanish }}
              <textarea id="podcast-show-description" name="description" rows="4"></textarea>
            </label>
            <label>{{ workbench.overview.descriptionEnglish }}
              <textarea id="podcast-show-description-en" name="descriptionEn" rows="4"></textarea>
            </label>
            <label>{{ workbench.overview.artworkUrl }}
              <input
                name="artworkUrl"
                type="url"
                inputmode="url"
                autocomplete="url"
                pattern="https://.*"
                maxlength="2000">
            </label>
            <div class="podcast-admin__callout">
              <p>{{ workbench.overview.permanentDestinationsHelp }}</p>
              <div class="podcast-admin__field-grid">
                <label>{{ workbench.overview.canonicalPage }}
                  <input name="canonicalUrl" type="url" readonly>
                </label>
                <label>{{ workbench.overview.rssFeed }}
                  <input name="feedUrl" type="url" readonly>
                </label>
              </div>
            </div>
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.overview.earlyAccessDays }}
                <input name="earlyAccessDays" type="number" min="0" max="365">
              </label>
              <label>{{ workbench.overview.youtubeChannel }}
                <input
                  name="youtubeChannelUrl"
                  type="url"
                  inputmode="url"
                  autocomplete="url"
                  pattern="https://(www\.|m\.)?youtube\.com/(?:@|channel/|c/|user/).+"
                  maxlength="2000">
              </label>
            </div>
            <label class="podcast-admin__checkbox">
              <input name="premiumEnabled" type="checkbox"> {{ workbench.overview.premiumEnabled }}
            </label>
            <label class="podcast-admin__checkbox">
              <input name="freeMiniEpisodeEnabled" type="checkbox"> {{ workbench.overview.freeMiniEnabled }}
            </label>
            <label class="podcast-admin__checkbox">
              <input name="explicit" type="checkbox"> {{ workbench.overview.explicit }}
            </label>
            <button class="btn btn-danger" type="submit">{{ workbench.overview.save }}</button>
            <p class="podcast-admin__status" data-podcast-show-status role="status" aria-live="polite"></p>
          </form>
          <section
            class="podcast-admin__form podcast-admin__form--settings"
            data-podcast-show-prices
            hidden>
            <h3>{{ workbench.overview.priceSettingsHeading }}</h3>
            <p>{{ workbench.overview.priceSettingsIntro }}</p>
            <dl
              class="podcast-admin__readiness-evidence"
              data-podcast-show-prices-summary></dl>
            <ul
              class="podcast-admin__certification-list"
              data-podcast-show-prices-blockers
              hidden></ul>
            <form
              class="podcast-admin__callout"
              data-podcast-show-prices-form
              hidden>
              <div class="podcast-admin__field-grid">
                <label>{{ workbench.overview.monthlyPriceUsd }}
                  <input
                    name="monthlyDollars"
                    type="number"
                    inputmode="decimal"
                    min="1"
                    max="10000"
                    step="0.01"
                    autocomplete="off"
                    required>
                </label>
                <label>{{ workbench.overview.annualPriceUsd }}
                  <input
                    name="annualDollars"
                    type="number"
                    inputmode="decimal"
                    min="1"
                    max="10000"
                    step="0.01"
                    autocomplete="off"
                    required>
                </label>
              </div>
              <p>{{ workbench.overview.priceSettingsSafety }}</p>
              <p data-podcast-show-prices-confirmation-hint></p>
              <label>{{ workbench.overview.priceSettingsConfirmation }}
                <input
                  name="confirmation"
                  type="text"
                  autocomplete="off"
                  maxlength="140"
                  required>
              </label>
              <div class="podcast-admin__billing-actions">
                <button class="btn btn-danger" type="submit">
                  {{ workbench.overview.priceSettingsSave }}
                </button>
              </div>
            </form>
            <p
              class="podcast-admin__status"
              data-podcast-show-prices-status
              role="status"
              aria-live="polite"></p>
          </section>
          <section
            class="podcast-admin__form podcast-admin__form--settings"
            data-podcast-site-projection
            hidden>
            <h3>{{ workbench.overview.siteProjectionHeading }}</h3>
            <p>{{ workbench.overview.siteProjectionIntro }}</p>
            <div class="podcast-admin__billing-actions">
              <button
                class="btn btn-outline-light"
                type="button"
                data-podcast-site-projection-preview>
                {{ workbench.overview.siteProjectionPreview }}
              </button>
            </div>
            <p
              class="podcast-admin__status"
              data-podcast-site-projection-status
              role="status"
              aria-live="polite"></p>
            <div data-podcast-site-projection-summary hidden></div>
            <form
              class="podcast-admin__callout"
              data-podcast-site-projection-form
              hidden>
              <p>{{ workbench.overview.siteProjectionPublishHelp }}</p>
              <p data-podcast-site-projection-confirmation-hint></p>
              <label>{{ workbench.overview.siteProjectionConfirmation }}
                <input
                  name="confirmation"
                  autocomplete="off"
                  spellcheck="false"
                  maxlength="120"
                  required>
              </label>
              <button class="btn btn-danger" type="submit">
                {{ workbench.overview.siteProjectionPublish }}
              </button>
            </form>
          </section>
        </section>
      </div>
    </div>
  </section>
</div>
