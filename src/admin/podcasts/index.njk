---
layout: layouts/podcast-admin.njk
disableLegacyMediaPreconnects: true
disableFontAwesome: true
customFont: true
i18nRuntime: true
translationKey: podcastAdmin
pagination:
  data: i18n.config.supportedLangs
  size: 1
  alias: language
permalink: "{{ i18n.config.pages.podcastAdmin[language] }}"
eleventyComputed:
  title: "{{ i18n[language].podcast.admin.title }}"
  description: "{{ i18n[language].podcast.admin.description }}"
---

{% set workbench = i18n[language].podcast.admin.workbench %}

<div
  class="podcast-admin__container"
  data-podcast-admin
  data-api-origin="{{ podcastAdmin.apiOrigin }}"
  data-turnstile-site-key="{{ podcastAdmin.turnstileSiteKey }}">
  <a class="visually-hidden-focusable" href="#podcast-admin-content">{{ i18n | t(language, "podcast.admin.skip") }}</a>

  <header class="podcast-admin__header">
    <div>
      <p class="podcast-admin__eyebrow">{{ i18n | t(language, "podcast.admin.eyebrow") }}</p>
      <h1>{{ i18n | t(language, "podcast.admin.heading") }}</h1>
      <p>{{ i18n | t(language, "podcast.admin.intro") }}</p>
    </div>
    <button class="btn btn-outline-light" type="button" data-podcast-logout hidden>{{ i18n | t(language, "podcast.admin.logOut") }}</button>
  </header>

  <p class="podcast-admin__status" data-podcast-global-status role="status" aria-live="polite"></p>

  <section class="podcast-admin__auth" data-podcast-auth aria-labelledby="podcast-login-title">
    <h2 id="podcast-login-title">{{ i18n | t(language, "podcast.admin.signIn") }}</h2>
    <p>{{ i18n | t(language, "podcast.admin.signInBody") }}</p>
    <form data-podcast-login-form>
      <label for="podcast-admin-email">{{ i18n | t(language, "podcast.admin.email") }}</label>
      <div class="podcast-admin__inline-form">
        <input id="podcast-admin-email" name="email" type="email" autocomplete="email" required>
        <button class="btn btn-danger" type="submit">{{ i18n | t(language, "podcast.admin.sendLink") }}</button>
      </div>
      {% if podcastAdmin.turnstileSiteKey %}
      <div
        id="podcast-turnstile"
        class="podcast-auth-turnstile podcast-admin__turnstile"></div>
      {% endif %}
    </form>
    <p class="podcast-admin__status" data-podcast-auth-status role="status" aria-live="polite"></p>
  </section>

  <section class="podcast-admin__app" data-podcast-app hidden>
    <p class="podcast-admin__session" data-podcast-session-summary></p>

    <div class="podcast-admin__tabs" data-podcast-tabs>
      <div class="podcast-admin__tab-list" role="tablist" aria-label="{{ i18n | t(language, 'podcast.admin.tabs.label') }}">
        <button id="podcast-tab-overview" type="button" role="tab" data-tab="overview" aria-controls="podcast-panel-overview">{{ i18n | t(language, "podcast.admin.tabs.overview") }}</button>
        <button id="podcast-tab-episodes" type="button" role="tab" data-tab="episodes" aria-controls="podcast-panel-episodes">{{ i18n | t(language, "podcast.admin.tabs.episodes") }}</button>
        <button id="podcast-tab-production" type="button" role="tab" data-tab="production" aria-controls="podcast-panel-production">{{ i18n | t(language, "podcast.admin.tabs.production") }}</button>
        <button id="podcast-tab-distribution" type="button" role="tab" data-tab="distribution" aria-controls="podcast-panel-distribution">{{ i18n | t(language, "podcast.admin.tabs.distribution") }}</button>
        <button id="podcast-tab-marketing" type="button" role="tab" data-tab="marketing" aria-controls="podcast-panel-marketing">{{ i18n | t(language, "podcast.admin.tabs.marketing") }}</button>
        <button id="podcast-tab-sponsors" type="button" role="tab" data-tab="sponsors" aria-controls="podcast-panel-sponsors">{{ i18n | t(language, "podcast.admin.tabs.sponsors") }}</button>
        <button id="podcast-tab-analytics" type="button" role="tab" data-tab="analytics" aria-controls="podcast-panel-analytics">{{ i18n | t(language, "podcast.admin.tabs.analytics") }}</button>
        <button id="podcast-tab-subscribers" type="button" role="tab" data-tab="subscribers" aria-controls="podcast-panel-subscribers">{{ i18n | t(language, "podcast.admin.tabs.subscribers") }}</button>
        <button id="podcast-tab-billing" type="button" role="tab" data-tab="billing" aria-controls="podcast-panel-billing">{{ i18n | t(language, "podcast.admin.tabs.premium") }}</button>
        <button id="podcast-tab-settings" type="button" role="tab" data-tab="settings" aria-controls="podcast-panel-settings">{{ i18n | t(language, "podcast.admin.tabs.settings") }}</button>
      </div>

      <div id="podcast-admin-content">
        <section id="podcast-panel-overview" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-overview">
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>{{ workbench.overview.shows }}</h2>
              <p>{{ workbench.overview.intro }}</p>
            </div>
            <button class="btn btn-outline-light" type="button" data-podcast-refresh>{{ workbench.common.refresh }}</button>
          </div>
          <div class="podcast-admin__cards" data-podcast-show-cards></div>

          <details class="podcast-admin__advanced-tools">
            <summary>{{ workbench.overview.advancedTools }}</summary>
            <form class="podcast-admin__form podcast-admin__form--settings" data-podcast-rss-import-form hidden>
              <h3>{{ workbench.overview.importHeading }}</h3>
              <p>{{ workbench.overview.importIntro }}</p>
              <label>{{ workbench.overview.importFeedUrl }}
                <input name="feedUrl" type="url" inputmode="url" autocomplete="url" required>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="ownershipConfirmed" type="checkbox" required>
                {{ workbench.overview.importOwnership }}
              </label>
              <p class="podcast-admin__callout">{{ workbench.overview.importPreviewOnly }}</p>
              <button class="btn btn-outline-light" type="submit">{{ workbench.overview.previewImport }}</button>
              <p class="podcast-admin__status" data-podcast-rss-import-status role="status" aria-live="polite"></p>
              <div class="podcast-admin__readiness-groups" data-podcast-rss-import-preview aria-live="polite"></div>
            </form>
            <section class="podcast-admin__form podcast-admin__form--settings" data-podcast-rss-import-plan-section hidden>
              <h3>{{ workbench.overview.importPlansHeading }}</h3>
              <p>{{ workbench.overview.importPlansIntro }}</p>
              <p class="podcast-admin__callout">{{ workbench.overview.importPlansZeroCopy }}</p>
              <div class="podcast-admin__readiness-list" data-podcast-rss-import-plans aria-live="polite"></div>
            </section>
          </details>
        </section>

        <section id="podcast-panel-episodes" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-episodes" hidden>
          <section
            class="podcast-admin__form podcast-admin__publish-workflow"
            data-podcast-publish-workflow
            hidden></section>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>{{ workbench.episodes.heading }}</h2>
              <p>{{ workbench.episodes.intro }}</p>
            </div>
            <select name="showId" data-podcast-show-select aria-label="{{ workbench.common.show }}"></select>
          </div>

          <form id="podcast-episode-details" class="podcast-admin__form" data-podcast-episode-form>
            <h3 data-podcast-episode-form-heading>{{ workbench.episodes.new }}</h3>
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.common.title }}
                <input name="title" autocomplete="off" required>
              </label>
              <label>{{ workbench.episodes.slug }}
                <input
                  name="slug"
                  pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                  aria-describedby="podcast-episode-slug-help"
                  required>
                <span
                  id="podcast-episode-slug-help"
                  class="podcast-admin__help"
                  data-podcast-episode-slug-help
                  hidden>{{ workbench.episodes.slugLocked }}</span>
              </label>
            </div>
            <label>{{ workbench.episodes.summary }}
              <textarea name="summary" rows="3" required></textarea>
            </label>
            <div class="podcast-admin__field">
              <span class="podcast-admin__field-label">{{ workbench.episodes.notes }}</span>
              <div class="podcast-admin__editor" data-podcast-notes-editor></div>
            </div>
            <section
              class="podcast-admin__callout podcast-admin__show-notes"
              data-podcast-show-notes
              hidden>
              <h4>{{ workbench.episodes.showNotesHeading }}</h4>
              <p>{{ workbench.episodes.showNotesIntro }}</p>
              <p class="podcast-admin__help">{{ workbench.episodes.showNotesReviewNotice }}</p>
              <div class="podcast-admin__field-grid">
                <label>{{ workbench.episodes.showNotesSourceLanguage }}
                  <select name="showNotesSourceLanguage" data-podcast-show-notes-source-language>
                    <option value="es">{{ workbench.common.spanish }}</option>
                    <option value="en">{{ workbench.common.english }}</option>
                  </select>
                </label>
                <label>{{ workbench.episodes.showNotesOutputLanguage }}
                  <select name="showNotesOutputLanguage" data-podcast-show-notes-output-language>
                    <option value="es">{{ workbench.common.spanish }}</option>
                    <option value="en">{{ workbench.common.english }}</option>
                  </select>
                </label>
              </div>
              <div class="podcast-admin__form-actions">
                <button
                  class="btn btn-outline-light"
                  type="button"
                  data-podcast-show-notes-generate>{{ workbench.episodes.showNotesGenerate }}</button>
              </div>
              <p
                class="podcast-admin__status"
                data-podcast-show-notes-status
                role="status"
                aria-live="polite"></p>
              <section
                class="podcast-admin__show-notes-review"
                data-podcast-show-notes-review
                aria-labelledby="podcast-show-notes-review-heading"
                hidden>
                <h4 id="podcast-show-notes-review-heading">{{ workbench.episodes.showNotesReviewHeading }}</h4>
                <p
                  class="podcast-admin__review-evidence"
                  data-podcast-show-notes-evidence></p>
                <h5>{{ workbench.episodes.showNotesSuggestedSummary }}</h5>
                <p
                  class="podcast-admin__show-notes-copy"
                  data-podcast-show-notes-summary></p>
                <h5>{{ workbench.episodes.showNotesDraftLabel }}</h5>
                <div
                  class="podcast-admin__show-notes-copy"
                  data-podcast-show-notes-draft></div>
                <h5>{{ workbench.episodes.showNotesKeywords }}</h5>
                <p
                  class="podcast-admin__show-notes-copy"
                  data-podcast-show-notes-keywords></p>
                <div class="podcast-admin__form-actions">
                  <button
                    class="btn btn-danger"
                    type="button"
                    data-podcast-show-notes-apply>{{ workbench.episodes.showNotesUseDraft }}</button>
                  <button
                    class="btn btn-outline-light"
                    type="button"
                    data-podcast-show-notes-dismiss>{{ workbench.episodes.showNotesDismiss }}</button>
                </div>
              </section>
            </section>
            <div class="podcast-admin__field-grid podcast-admin__field-grid--three">
              <label>{{ workbench.episodes.access }}
                <select name="access">
                  <option value="public">{{ workbench.episodes.public }}</option>
                  <option value="early_access">{{ workbench.episodes.earlyAccess }}</option>
                  <option value="premium_bonus">{{ workbench.episodes.premiumBonus }}</option>
                  <option value="free_mini">{{ workbench.episodes.freeMini }}</option>
                </select>
              </label>
              <label>{{ workbench.episodes.sourceLanguage }}
                <select name="sourceLanguage" required>
                  <option value="es">{{ workbench.common.spanish }}</option>
                  <option value="en">{{ workbench.common.english }}</option>
                </select>
              </label>
              <label>{{ workbench.episodes.premiumRelease }}
                <input name="premiumAt" type="datetime-local">
              </label>
              <label>{{ workbench.episodes.publicRelease }}
                <input name="publicAt" type="datetime-local">
              </label>
            </div>
            <div class="podcast-admin__form-actions">
              <button class="btn btn-danger" type="submit">{{ workbench.episodes.createDraft }}</button>
              <button
                class="btn btn-outline-light"
                type="button"
                data-podcast-episode-edit-cancel
                hidden>{{ workbench.episodes.cancelEdit }}</button>
            </div>
            <p class="podcast-admin__status" data-podcast-episode-status role="status" aria-live="polite"></p>
          </form>

          <form class="podcast-admin__form" data-podcast-upload-form>
            <h3>{{ workbench.episodes.attachMedia }}</h3>
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.common.episode }}
                <select name="episodeId" required></select>
              </label>
              <label>{{ workbench.episodes.mediaRole }}
                <select name="kind">
                  <option value="delivery_audio">{{ workbench.episodes.deliveryAudio }}</option>
                  <option value="source_audio">{{ workbench.episodes.sourceAudio }}</option>
                  <option value="video_source">{{ workbench.episodes.videoSource }}</option>
                </select>
              </label>
            </div>
            <label>{{ workbench.episodes.file }}
              <input name="media" type="file" accept="audio/*,video/mp4,video/quicktime,video/webm" required>
            </label>
            <progress data-podcast-upload-progress max="100" value="0" hidden></progress>
            <button class="btn btn-outline-light" type="submit">{{ workbench.episodes.uploadMedia }}</button>
            <p class="podcast-admin__status" data-podcast-upload-status role="status" aria-live="polite"></p>
          </form>

          <form class="podcast-admin__form" data-podcast-ad-plan-form hidden>
            <h3>{{ workbench.episodes.adPlanHeading }}</h3>
            <p>{{ workbench.episodes.adPlanIntro }}</p>
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.common.episode }}
                <select name="episodeId" required></select>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="preRoll" type="checkbox"> {{ workbench.common.preRoll }}
              </label>
              <label class="podcast-admin__checkbox">
                <input name="midRoll" type="checkbox"> {{ workbench.common.midRoll }}
              </label>
              <label>{{ workbench.episodes.midRollTime }}
                <input name="midRollSeconds" type="number" min="1" step="1" disabled>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="postRoll" type="checkbox"> {{ workbench.common.postRoll }}
              </label>
            </div>
            <button class="btn btn-outline-light" type="submit">{{ workbench.episodes.submitAdPlan }}</button>
            <p class="podcast-admin__status" data-podcast-ad-plan-status role="status" aria-live="polite"></p>
          </form>
          <div data-podcast-ad-plan-result aria-live="polite"></div>

          <div class="podcast-admin__episode-list" data-podcast-episode-list></div>
        </section>

        <section id="podcast-panel-production" class="podcast-admin__panel" role="tabpanel" aria-labelledby="podcast-tab-production" hidden>
          <div class="podcast-admin__panel-heading">
            <div>
              <h2>{{ workbench.production.audioQcHeading }}</h2>
              <p>{{ workbench.production.audioQcIntro }}</p>
            </div>
            <p class="podcast-admin__pill">{{ workbench.production.measuredPill }}</p>
          </div>
          <div class="podcast-admin__callout">
            <p>{{ workbench.production.audioQcCallout }}</p>
            <p data-podcast-audio-qc-policy-summary aria-live="polite">{{ workbench.production.policyLoading }}</p>
          </div>
          <form class="podcast-admin__form podcast-admin__audio-qc-policy" data-podcast-audio-qc-policy-form hidden>
            <h3>{{ workbench.production.policyHeading }}</h3>
            <p>{{ workbench.production.policyIntro }}</p>
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.production.monoTarget }}
                <input name="monoIntegratedLufs" type="number" min="-40" max="-5" step="0.1" required>
              </label>
              <label>{{ workbench.production.stereoTarget }}
                <input name="stereoIntegratedLufs" type="number" min="-40" max="-5" step="0.1" required>
              </label>
              <label>{{ workbench.production.loudnessTolerance }}
                <input name="integratedLufsTolerance" type="number" min="0.1" max="10" step="0.1" required>
              </label>
              <label>{{ workbench.production.maximumTruePeak }}
                <input name="maximumTruePeakDbtp" type="number" min="-12" max="0" step="0.1" required>
              </label>
              <label>{{ workbench.production.maximumDcOffset }}
                <input name="maximumDcOffset" type="number" min="0" max="0.25" step="0.001" required>
              </label>
              <label>{{ workbench.production.maximumChannelImbalance }}
                <input name="maximumChannelImbalanceLu" type="number" min="0" max="24" step="0.1" required>
              </label>
              <label>{{ workbench.production.maximumLeadingSilence }}
                <input name="maximumLeadingSilenceMs" type="number" min="0" max="60000" step="1" required>
              </label>
              <label>{{ workbench.production.maximumTrailingSilence }}
                <input name="maximumTrailingSilenceMs" type="number" min="0" max="60000" step="1" required>
              </label>
              <label>{{ workbench.production.maximumInternalSilence }}
                <input name="maximumInternalSilenceMs" type="number" min="0" max="120000" step="1" required>
              </label>
              <label>{{ workbench.production.silenceThreshold }}
                <input name="silenceThresholdDb" type="number" min="-100" max="-10" step="0.1" required>
              </label>
            </div>
            <button class="btn btn-outline-light" type="submit">{{ workbench.production.savePolicy }}</button>
            <p class="podcast-admin__status" data-podcast-audio-qc-policy-status role="status" aria-live="polite"></p>
          </form>
          <section class="podcast-admin__audio-qc" data-podcast-audio-qc aria-label="{{ workbench.production.audioQcHeading }}">
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.common.episode }}
                <select name="audioQcEpisodeId" data-podcast-audio-qc-episode required></select>
              </label>
            </div>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-danger" type="button" data-podcast-audio-qc-queue>{{ workbench.production.queueQc }}</button>
              <button class="btn btn-outline-light" type="button" data-podcast-audio-qc-refresh>{{ workbench.production.refreshReport }}</button>
            </div>
            <p class="podcast-admin__transcript-meta" data-podcast-audio-qc-summary aria-live="polite">{{ workbench.production.chooseSourceAudio }}</p>
            <div class="podcast-admin__audio-qc-results" data-podcast-audio-qc-results></div>
            <p class="podcast-admin__status" data-podcast-audio-qc-status role="status" aria-live="polite"></p>
          </section>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
              <h2>{{ workbench.production.workingMasterHeading }}</h2>
              <p>{{ workbench.production.workingMasterIntro }}</p>
            </div>
            <p class="podcast-admin__pill">{{ workbench.production.explicitPill }}</p>
          </div>
          <div class="podcast-admin__callout">
            <p>{{ workbench.production.masterCallout }}</p>
          </div>
          <section class="podcast-admin__audio-master" data-podcast-audio-master aria-label="{{ workbench.production.workingMasterLabel }}">
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.common.episode }}
                <select name="audioMasterEpisodeId" data-podcast-audio-master-episode required></select>
              </label>
            </div>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-audio-master-refresh>{{ workbench.production.refreshMaster }}</button>
            </div>
            <p class="podcast-admin__transcript-meta" data-podcast-audio-master-summary aria-live="polite">{{ workbench.production.chooseQc }}</p>
            <div class="podcast-admin__audio-master-current" data-podcast-audio-master-current></div>

            <form class="podcast-admin__form podcast-admin__audio-master-approval" data-podcast-audio-master-approval hidden>
              <h3>{{ workbench.production.approveSourceHeading }}</h3>
              <p>{{ workbench.production.approveSourceIntro }}</p>
              <label>{{ workbench.production.approvalReason }}
                <textarea name="approvalReason" rows="3" maxlength="500" required></textarea>
              </label>
              <label class="podcast-admin__checkbox">
                <input name="acknowledgeExactSource" type="checkbox" required>
                {{ workbench.production.exactSourceAck }}
              </label>
              <button class="btn btn-danger" type="submit">{{ workbench.production.approveMaster }}</button>
              <p class="podcast-admin__status" data-podcast-audio-master-approval-status role="status" aria-live="polite"></p>
            </form>

            <form class="podcast-admin__form podcast-admin__audio-enhancement-form" data-podcast-audio-enhancement-form hidden>
              <h3>{{ workbench.production.enhancementHeading }}</h3>
              <p>{{ workbench.production.enhancementIntro }}</p>
              <div class="podcast-admin__field-grid podcast-admin__field-grid--three">
                <label>{{ workbench.production.preset }}
                  <select name="presetId" required></select>
                </label>
                <label>{{ workbench.production.startSeconds }}
                  <input name="previewStartSeconds" type="number" min="0" step="0.1" value="0" required>
                </label>
                <label>{{ workbench.production.lengthSeconds }}
                  <input name="previewDurationSeconds" type="number" min="5" max="90" step="1" value="45" required>
                </label>
              </div>
              <button class="btn btn-outline-light" type="submit">{{ workbench.production.queuePreview }}</button>
              <p class="podcast-admin__status" data-podcast-audio-enhancement-status role="status" aria-live="polite"></p>
            </form>

            <div class="podcast-admin__audio-enhancement-results" data-podcast-audio-enhancement-results></div>

            <section class="podcast-admin__form podcast-admin__audio-derivative-workbench" data-podcast-audio-derivatives>
              <div class="podcast-admin__panel-heading podcast-admin__section-heading">
                <div>
                  <h3>{{ workbench.production.derivativeHeading }}</h3>
                  <p>{{ workbench.production.derivativeIntro }}</p>
                </div>
                <p class="podcast-admin__pill">{{ workbench.production.fullQcPill }}</p>
              </div>
              <div class="podcast-admin__callout">
                <p>{{ workbench.production.derivativeCallout }}</p>
              </div>
              <p class="podcast-admin__status" data-podcast-audio-derivative-status role="status" aria-live="polite"></p>
              <div class="podcast-admin__audio-enhancement-results" data-podcast-audio-derivative-results></div>
            </section>
          </section>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
              <h2>{{ workbench.production.deliveryAudioHeading }}</h2>
              <p>{{ workbench.production.deliveryAudioIntro }}</p>
            </div>
            <p class="podcast-admin__pill">{{ workbench.production.deliveryAudioPill }}</p>
          </div>
          <div class="podcast-admin__callout">
            <p>{{ workbench.production.deliveryAudioCallout }}</p>
          </div>
          <section class="podcast-admin__form podcast-admin__delivery-audio" data-podcast-delivery-audio aria-label="{{ workbench.production.deliveryAudioLabel }}">
            <div class="podcast-admin__field-grid">
              <label>{{ workbench.common.episode }}
                <select name="deliveryAudioEpisodeId" data-podcast-delivery-audio-episode required></select>
              </label>
            </div>
            <div class="podcast-admin__transcript-actions">
              <button class="btn btn-outline-light" type="button" data-podcast-delivery-audio-refresh>{{ workbench.production.deliveryAudioRefresh }}</button>
              <button class="btn btn-danger" type="button" data-podcast-delivery-audio-queue disabled>{{ workbench.production.deliveryAudioQueue }}</button>
            </div>
            <p class="podcast-admin__transcript-meta" data-podcast-delivery-audio-summary aria-live="polite">{{ workbench.production.deliveryAudioChoose }}</p>
            <p class="podcast-admin__status" data-podcast-delivery-audio-status role="status" aria-live="polite"></p>
            <div class="podcast-admin__audio-enhancement-results" data-podcast-delivery-audio-results></div>
          </section>
          <div class="podcast-admin__panel-heading podcast-admin__section-heading">
            <div>
