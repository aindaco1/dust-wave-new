---
layout: layouts/default.njk
footer: footer1
bodyModifier: podcast-show-page
pagination:
  data: podcastShows
  size: 1
  alias: show
permalink: "podcasts/{{ show.slug }}/index.html"
eleventyComputed:
  title: "{{ show.title }} — Dust Wave Podcasts"
  description: "{{ show.description }} {{ show.descriptionEn }}"
  language: "{{ show.language }}"
  og_image: "{{ show.socialImage }}"
  og_alt: "{{ show.title }}"
  og_image_width: "{{ show.socialImageWidth }}"
  og_image_height: "{{ show.socialImageHeight }}"
---

<article
  class="podcast-show"
  {% if show.premium.enabled %}
  data-podcast-checkout-root
  data-api-origin="{{ podcastMember.apiOrigin }}"
  data-show-slug="{{ show.slug }}"
  data-turnstile-site-key="{{ podcastMember.checkoutTurnstileSiteKey }}"
  {% endif %}>
  <header class="podcast-show__hero">
    <div class="container">
      <div class="podcast-show__wordmark-wrap">
        <img
          class="podcast-show__wordmark"
          src="{{ show.wordmark }}"
          alt="{{ show.title }}"
          width="2708"
          height="532"
          decoding="async">
      </div>

      <div class="row align-items-center gy-4">
        <div class="col-12 col-md-5 col-lg-4">
          <img
            class="podcast-show__artwork"
            src="{{ show.artwork }}"
            alt="Portada de {{ show.title }}"
            width="505"
            height="505"
            decoding="async">
        </div>
        <div class="col-12 col-md-7 col-lg-8">
          <p class="podcast-show__eyebrow">Un podcast de Dust Wave</p>
          <h1>{{ show.title }}</h1>
          <div class="podcast-show__description">
            <p lang="es">{{ show.description }}</p>
            <p lang="en">{{ show.descriptionEn }}</p>
          </div>
          <div class="podcast-show__actions">
            <a class="btn btn-light" href="#episodios">Episodios</a>
            <a class="btn btn-outline-light" href="{{ show.sourceUrl }}" rel="noopener noreferrer">Visita el Substack</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="podcast-show__membership" aria-labelledby="podcast-membership-title">
    <div class="container">
      <div class="row g-4">
        <div class="col-12 col-lg-6">
          <div class="podcast-tier-card">
            <p class="podcast-tier-card__label">Podcast público</p>
            <h2 id="podcast-membership-title">{{ show.publicAccess.label }}</h2>
            <p>Los episodios públicos estarán disponibles aquí y en el feed del podcast.</p>
            {% if show.freeMiniEpisode.enabled %}
            <p>Incluye un mini episodio gratuito para conocer el programa.</p>
            {% endif %}
          </div>
        </div>
        {% if show.premium.enabled %}
        <div class="col-12 col-lg-6">
          <div class="podcast-tier-card podcast-tier-card--premium">
            <p class="podcast-tier-card__label">Premium</p>
            <h2>
              ${{ show.premium.monthlyCents / 100 | round }}/mes
              <span>o ${{ show.premium.annualCents / 100 | round }}/año</span>
            </h2>
            <ul>
              {% for benefit in show.premium.benefits %}
              <li>{{ benefit }}</li>
              {% endfor %}
            </ul>
            <p>{{ show.earlyAccess.days }} días de acceso anticipado, con ajustes por episodio.</p>
            <p
              class="podcast-checkout__availability"
              data-podcast-checkout-unavailable
              role="status">
              Premium próximamente / Premium coming soon
            </p>
            <form class="podcast-checkout" data-podcast-checkout-form hidden>
              <fieldset class="podcast-checkout__plans">
                <legend>Elige tu plan / Choose your plan</legend>
                <label data-podcast-plan="month">
                  <input type="radio" name="billingPeriod" value="month" checked>
                  <span>
                    <strong>Mensual / Monthly</strong>
                    <small data-podcast-plan-price="month">
                      ${{ show.premium.monthlyCents / 100 | round }}/mes
                    </small>
                  </span>
                </label>
                <label data-podcast-plan="year">
                  <input type="radio" name="billingPeriod" value="year">
                  <span>
                    <strong>Anual / Annual</strong>
                    <small data-podcast-plan-price="year">
                      ${{ show.premium.annualCents / 100 | round }}/año
                    </small>
                  </span>
                </label>
              </fieldset>

              <div class="podcast-checkout__fields">
                <div class="podcast-checkout__field podcast-checkout__field--wide">
                  <label for="podcast-checkout-email">Correo / Email</label>
                  <input
                    id="podcast-checkout-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    inputmode="email"
                    maxlength="254"
                    required>
                </div>
                <div class="podcast-checkout__field">
                  <label for="podcast-checkout-country">País / Country</label>
                  <select
                    id="podcast-checkout-country"
                    name="country"
                    autocomplete="country"
                    required>
                    <option value="">Selecciona / Select</option>
                  </select>
                </div>
                <div
                  class="podcast-checkout__field"
                  data-podcast-us-state-field>
                  <label for="podcast-checkout-state">Estado / State</label>
                  <select
                    id="podcast-checkout-state"
                    name="usState"
                    autocomplete="address-level1"
                    required>
                    <option value="">Selecciona / Select</option>
                    <option value="AL">Alabama</option>
                    <option value="AK">Alaska</option>
                    <option value="AZ">Arizona</option>
                    <option value="AR">Arkansas</option>
                    <option value="CA">California</option>
                    <option value="CO">Colorado</option>
                    <option value="CT">Connecticut</option>
                    <option value="DE">Delaware</option>
                    <option value="DC">District of Columbia</option>
                    <option value="FL">Florida</option>
                    <option value="GA">Georgia</option>
                    <option value="HI">Hawaii</option>
                    <option value="ID">Idaho</option>
                    <option value="IL">Illinois</option>
                    <option value="IN">Indiana</option>
                    <option value="IA">Iowa</option>
                    <option value="KS">Kansas</option>
                    <option value="KY">Kentucky</option>
                    <option value="LA">Louisiana</option>
                    <option value="ME">Maine</option>
                    <option value="MD">Maryland</option>
                    <option value="MA">Massachusetts</option>
                    <option value="MI">Michigan</option>
                    <option value="MN">Minnesota</option>
                    <option value="MS">Mississippi</option>
                    <option value="MO">Missouri</option>
                    <option value="MT">Montana</option>
                    <option value="NE">Nebraska</option>
                    <option value="NV">Nevada</option>
                    <option value="NH">New Hampshire</option>
                    <option value="NJ">New Jersey</option>
                    <option value="NM">New Mexico</option>
                    <option value="NY">New York</option>
                    <option value="NC">North Carolina</option>
                    <option value="ND">North Dakota</option>
                    <option value="OH">Ohio</option>
                    <option value="OK">Oklahoma</option>
                    <option value="OR">Oregon</option>
                    <option value="PA">Pennsylvania</option>
                    <option value="RI">Rhode Island</option>
                    <option value="SC">South Carolina</option>
                    <option value="SD">South Dakota</option>
                    <option value="TN">Tennessee</option>
                    <option value="TX">Texas</option>
                    <option value="UT">Utah</option>
                    <option value="VT">Vermont</option>
                    <option value="VA">Virginia</option>
                    <option value="WA">Washington</option>
                    <option value="WV">West Virginia</option>
                    <option value="WI">Wisconsin</option>
                    <option value="WY">Wyoming</option>
                  </select>
                </div>
                <div
                  class="podcast-checkout__field"
                  data-podcast-region-field
                  hidden>
                  <label for="podcast-checkout-region">
                    Región / State or province
                  </label>
                  <input
                    id="podcast-checkout-region"
                    name="region"
                    type="text"
                    autocomplete="address-level1"
                    maxlength="64"
                    disabled>
                </div>
                <div class="podcast-checkout__field">
                  <label for="podcast-checkout-postal">
                    Código postal / Postal code
                  </label>
                  <input
                    id="podcast-checkout-postal"
                    name="postalCode"
                    type="text"
                    autocomplete="postal-code"
                    maxlength="20"
                    required>
                </div>
                <div class="podcast-checkout__field">
                  <label for="podcast-checkout-city">Ciudad / City</label>
                  <input
                    id="podcast-checkout-city"
                    name="city"
                    type="text"
                    autocomplete="address-level2"
                    maxlength="96"
                    required>
                </div>
                <div class="podcast-checkout__field podcast-checkout__field--wide">
                  <label for="podcast-checkout-line1">
                    Dirección / Address
                  </label>
                  <input
                    id="podcast-checkout-line1"
                    name="line1"
                    type="text"
                    autocomplete="address-line1"
                    maxlength="192"
                    required>
                </div>
                <div class="podcast-checkout__field podcast-checkout__field--wide">
                  <label for="podcast-checkout-line2">
                    Apartamento, suite, etc. (opcional) / Address line 2 (optional)
                  </label>
                  <input
                    id="podcast-checkout-line2"
                    name="line2"
                    type="text"
                    autocomplete="address-line2"
                    maxlength="192">
                </div>
              </div>

              <div
                class="podcast-checkout__quote"
                data-podcast-checkout-quote
                aria-labelledby="podcast-checkout-total-title"
                hidden>
                <h3 id="podcast-checkout-total-title">
                  Total de hoy / Today’s total
                </h3>
                <dl>
                  <div>
                    <dt>Suscripción / Subscription</dt>
                    <dd data-podcast-quote-subtotal></dd>
                  </div>
                  <div>
                    <dt>Impuesto / Tax</dt>
                    <dd data-podcast-quote-tax></dd>
                  </div>
                  <div class="podcast-checkout__quote-total">
                    <dt>Total</dt>
                    <dd data-podcast-quote-total></dd>
                  </div>
                </dl>
                <p data-podcast-quote-jurisdiction></p>
              </div>

              <div
                id="podcast-checkout-turnstile"
                class="podcast-checkout__turnstile"
                hidden></div>
              <button
                class="btn btn-danger podcast-checkout__submit"
                type="submit"
                data-podcast-checkout-submit>
                Calcular total / Review total
              </button>
              <p class="podcast-checkout__fine-print">
                Revisarás el total antes de ir al pago seguro de Stripe.
                Cancelación disponible desde tu cuenta. /
                You’ll review the total before continuing to secure Stripe
                Checkout. Cancel anytime from your account.
              </p>
              <p
                class="podcast-checkout__status"
                data-podcast-checkout-status
                role="status"
                aria-live="polite"></p>
            </form>
            <p class="mt-3 mb-0">
              <a href="/podcasts/account/">¿Ya estás suscrito? Abre tu cuenta. / Already subscribed? Open your account.</a>
            </p>
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="podcast-show__episodes" id="episodios" aria-labelledby="podcast-episodes-title">
    <div class="container">
      <h2 id="podcast-episodes-title">Episodios</h2>
      {% set publishedEpisodes = podcastEpisodePublications | podcastEpisodesForShow(show.slug) %}
      {% set displayEpisodes = publishedEpisodes if publishedEpisodes.length else show.episodes %}
      {% if displayEpisodes.length %}
        <div class="podcast-show__episode-list">
          {% for episode in displayEpisodes %}
            <article class="podcast-show__episode">
              <h3><a href="{{ episode.url }}">{{ episode.title }}</a></h3>
              {% if episode.summary %}<p>{{ episode.summary }}</p>{% endif %}
              {% set playerId = show.slug + "_" + episode.slug %}
              {% set title = episode.title %}
              {% set audioUrl = episode.audioUrl %}
              {% set downloadUrl = episode.downloadUrl or episode.audioUrl %}
              {% set artworkUrl = episode.artwork or show.artwork %}
              {% set artworkAlt = "Portada de " + episode.title %}
              {% set peaksUrl = episode.peaksUrl %}
              {% set playerLanguage = show.language %}
              {% include "snippets/audio-player.njk" %}
              <p><a href="{{ episode.url }}">Notas, transcripción y capítulos del episodio</a></p>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="podcast-show__empty">
          <p class="podcast-show__empty-kicker">Muy pronto</p>
          <h3>Los episodios están en camino.</h3>
          <p>Esta página ya es el hogar permanente del podcast. Vuelve pronto para escuchar el primer episodio.</p>
        </div>
      {% endif %}
    </div>
  </section>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  "name": {{ show.title | dump | safe }},
  "description": {{ (show.description + " " + show.descriptionEn) | dump | safe }},
  "url": {{ (metadata.url + "/podcasts/" + show.slug + "/") | dump | safe }},
  "image": {{ (metadata.url + show.artwork) | dump | safe }},
  "inLanguage": {{ show.language | dump | safe }},
  "publisher": {
    "@type": "Organization",
    "name": "Dust Wave",
    "url": {{ metadata.url | dump | safe }}
  }
}
</script>
{% if show.premium.enabled %}
<script type="module" src="/js/podcast-checkout.js"></script>
{% endif %}
