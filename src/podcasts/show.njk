---
layout: layouts/default.njk
footer: footer1
bodyModifier: podcast-show-page
pagination:
  data: podcastShowPages
  size: 1
  alias: showPage
permalink: "{{ showPage.path }}"
disableLegacyMediaPreconnects: true
i18nRuntime: true
i18nRuntimeSections:
  - checkout
eleventyComputed:
  title: "{{ showPage.show.title }} — {{ i18n[showPage.language].podcast.brand }}"
  description: "{% if showPage.language == 'es' %}{{ showPage.show.description }}{% else %}{{ showPage.show.descriptionEn }}{% endif %}"
  language: "{{ showPage.language }}"
  podcastShowSlug: "{{ showPage.show.slug }}"
  og_image: "{{ showPage.show.socialImage }}"
  og_alt: "{{ showPage.show.title }}"
  og_image_width: "{{ showPage.show.socialImageWidth }}"
  og_image_height: "{{ showPage.show.socialImageHeight }}"
---

{% set show = showPage.show %}
<article
  class="podcast-show"
  {% if show.premium.enabled %}
  data-podcast-checkout-root
  data-api-origin="{{ podcastMember.apiOrigin }}"
  data-show-slug="{{ show.slug }}"
  data-turnstile-site-key="{{ podcastMember.checkoutTurnstileSiteKey }}"
  {% endif %}>
  <header class="podcast-show__hero">
    <div class="container">
      <div class="podcast-show__wordmark-wrap">
        <picture>
          <source
            srcset="{{ show.wordmarkWebpSmall }} 640w, {{ show.wordmarkWebp }} 1280w, {{ show.wordmarkWebpLarge }} 2560w"
            sizes="(min-width: 1200px) 1088px, calc(100vw - 24px)"
            type="image/webp">
          <img
            class="podcast-show__wordmark"
            src="{{ show.wordmark }}"
            alt=""
            width="2708"
            height="532"
            decoding="async">
        </picture>
      </div>

      <div class="row align-items-center gy-4">
        <div class="col-12 col-md-5 col-lg-4">
          <picture>
            <source
              srcset="{{ show.artworkWebpSmall }} 256w, {{ show.artworkWebp }} 505w"
              sizes="(min-width: 992px) 33vw, (min-width: 768px) 42vw, calc(100vw - 24px)"
              type="image/webp">
            <img
              class="podcast-show__artwork"
              src="{{ show.artwork }}"
              alt="{{ i18n | t(language, 'podcast.artworkAlt', { title: show.title }) }}"
              width="505"
              height="505"
              decoding="async"
              fetchpriority="high">
          </picture>
        </div>
        <div class="col-12 col-md-7 col-lg-8">
          <p class="podcast-show__eyebrow">{{ i18n | t(language, "podcast.showEyebrow") }}</p>
          <h1>{{ show.title }}</h1>
          <div class="podcast-show__description">
            <p>{{ show.description if language == "es" else show.descriptionEn }}</p>
          </div>
          <div class="podcast-show__actions">
            <a class="btn btn-light" href="#episodes">{{ i18n | t(language, "podcast.episodes") }}</a>
            <a class="btn btn-outline-light" href="{{ show.sourceUrl }}" rel="noopener noreferrer">{{ i18n | t(language, "podcast.visitSource") }}</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section
    class="podcast-show__membership"
    id="podcast-membership"
    aria-labelledby="podcast-membership-title">
    <div class="container">
      <div class="row g-4">
        <div class="col-12 col-lg-6">
          <div class="podcast-tier-card">
            <p class="podcast-tier-card__label">{{ i18n | t(language, "podcast.publicPodcast") }}</p>
            <h2 id="podcast-membership-title">{{ i18n | t(language, "podcast.free") }}</h2>
            <p>{{ i18n | t(language, "podcast.publicDescription") }}</p>
            {% if show.freeMiniEpisode.enabled %}
            <p>{{ i18n | t(language, "podcast.miniEpisode") }}</p>
            {% endif %}
          </div>
        </div>
        {% if show.premium.enabled %}
        <div class="col-12 col-lg-6">
          <div class="podcast-tier-card podcast-tier-card--premium">
            <p class="podcast-tier-card__label">Premium</p>
            <h2>
              {{ show.premium.monthlyCents | localizedPodcastPrice(language, show.premium.currency) }}{{ i18n | t(language, "podcast.perMonth") }}
              <span>{{ i18n | t(language, "podcast.orPerYear", { amount: (show.premium.annualCents | localizedPodcastPrice(language, show.premium.currency)) }) }}</span>
            </h2>
            <ul>
              <li>{{ i18n | t(language, "podcast.bonusEpisodes") }}</li>
              <li>{{ i18n | t(language, "podcast.earlyAccess") }}</li>
            </ul>
            <p>{{ i18n | t(language, "podcast.earlyAccessDays", { days: show.earlyAccess.days }) }}</p>
            <p
              class="podcast-checkout__availability"
              data-podcast-checkout-unavailable
              role="status">
              {{ i18n | t(language, "podcast.premiumComingSoon") }}
            </p>
            <form class="podcast-checkout" data-podcast-checkout-form hidden>
              <fieldset class="podcast-checkout__plans">
                <legend>{{ i18n | t(language, "podcast.choosePlan") }}</legend>
                <label data-podcast-plan="month">
                  <input type="radio" name="billingPeriod" value="month" checked>
                  <span>
                    <strong>{{ i18n | t(language, "podcast.monthly") }}</strong>
                    <small data-podcast-plan-price="month">
                      {{ show.premium.monthlyCents | localizedPodcastPrice(language, show.premium.currency) }}{{ i18n | t(language, "podcast.perMonth") }}
                    </small>
                  </span>
                </label>
                <label data-podcast-plan="year">
                  <input type="radio" name="billingPeriod" value="year">
                  <span>
                    <strong>{{ i18n | t(language, "podcast.annual") }}</strong>
                    <small data-podcast-plan-price="year">
                      {{ show.premium.annualCents | localizedPodcastPrice(language, show.premium.currency) }}{{ i18n | t(language, "podcast.perYear") }}
                    </small>
                  </span>
                </label>
              </fieldset>

              <div class="podcast-checkout__fields">
                <div class="podcast-checkout__field podcast-checkout__field--wide">
                  <label for="podcast-checkout-email">{{ i18n | t(language, "podcast.email") }}</label>
                  <input
                    id="podcast-checkout-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    inputmode="email"
                    maxlength="254"
                    required>
                </div>
                <div class="podcast-checkout__field">
                  <label for="podcast-checkout-country">{{ i18n | t(language, "podcast.country") }}</label>
                  <select
                    id="podcast-checkout-country"
                    name="country"
                    autocomplete="country"
                    required>
                    <option value="">{{ i18n | t(language, "podcast.select") }}</option>
                  </select>
                </div>
                <div
                  class="podcast-checkout__field"
                  data-podcast-us-state-field>
                  <label for="podcast-checkout-state">{{ i18n | t(language, "podcast.state") }}</label>
                  <select
                    id="podcast-checkout-state"
                    name="usState"
                    autocomplete="address-level1"
                    required>
                    <option value="">{{ i18n | t(language, "podcast.select") }}</option>
                    {% for state in usStates %}
                      <option value="{{ state.code }}">{{ state[language] }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div
                  class="podcast-checkout__field"
                  data-podcast-region-field
                  hidden>
                  <label for="podcast-checkout-region">
                    {{ i18n | t(language, "podcast.region") }}
                  </label>
                  <input
                    id="podcast-checkout-region"
                    name="region"
                    type="text"
                    autocomplete="address-level1"
                    maxlength="64"
                    disabled>
                </div>
                <div class="podcast-checkout__field">
                  <label for="podcast-checkout-postal">
                    {{ i18n | t(language, "podcast.postalCode") }}
                  </label>
                  <input
                    id="podcast-checkout-postal"
                    name="postalCode"
                    type="text"
                    autocomplete="postal-code"
                    maxlength="20"
                    required>
                </div>
                <div class="podcast-checkout__field">
                  <label for="podcast-checkout-city">{{ i18n | t(language, "podcast.city") }}</label>
                  <input
                    id="podcast-checkout-city"
                    name="city"
                    type="text"
                    autocomplete="address-level2"
                    maxlength="96"
                    required>
                </div>
                <div class="podcast-checkout__field podcast-checkout__field--wide">
                  <label for="podcast-checkout-line1">
                    {{ i18n | t(language, "podcast.address") }}
                  </label>
                  <input
                    id="podcast-checkout-line1"
                    name="line1"
                    type="text"
                    autocomplete="address-line1"
                    maxlength="192"
                    required>
                </div>
                <div class="podcast-checkout__field podcast-checkout__field--wide">
                  <label for="podcast-checkout-line2">
                    {{ i18n | t(language, "podcast.address2") }}
                  </label>
                  <input
                    id="podcast-checkout-line2"
                    name="line2"
                    type="text"
                    autocomplete="address-line2"
                    maxlength="192">
                </div>
              </div>

              <div
                class="podcast-checkout__quote"
                data-podcast-checkout-quote
                aria-labelledby="podcast-checkout-total-title"
                hidden>
                <h3 id="podcast-checkout-total-title">
                  {{ i18n | t(language, "podcast.todayTotal") }}
                </h3>
                <dl>
                  <div>
                    <dt>{{ i18n | t(language, "podcast.subscription") }}</dt>
                    <dd data-podcast-quote-subtotal></dd>
                  </div>
                  <div>
                    <dt>{{ i18n | t(language, "podcast.tax") }}</dt>
                    <dd data-podcast-quote-tax></dd>
                  </div>
                  <div class="podcast-checkout__quote-total">
                    <dt>{{ i18n | t(language, "podcast.total") }}</dt>
                    <dd data-podcast-quote-total></dd>
                  </div>
                </dl>
                <p data-podcast-quote-jurisdiction></p>
              </div>

              <div
                id="podcast-checkout-turnstile"
                class="podcast-checkout__turnstile"
                hidden></div>
              <button
                class="btn btn-danger podcast-checkout__submit"
                type="submit"
                data-podcast-checkout-submit>
                {{ i18n | t(language, "podcast.reviewTotal") }}
              </button>
              <p class="podcast-checkout__fine-print">
                {{ i18n | t(language, "podcast.checkoutFinePrint") }}
              </p>
              <p
                class="podcast-checkout__status"
                data-podcast-checkout-status
                role="status"
                aria-live="polite"></p>
            </form>
            <p class="mt-3 mb-0">
              <a href="{{ i18n | localizedUrl(language, 'podcastAccount', '/podcasts/account/') }}">{{ i18n | t(language, "podcast.openAccount") }}</a>
            </p>
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="podcast-show__episodes" id="episodes" aria-labelledby="podcast-episodes-title">
    <div class="container">
      <h2 id="podcast-episodes-title">{{ i18n | t(language, "podcast.episodes") }}</h2>
      {% set publishedEpisodes = podcastEpisodePublications | podcastEpisodesForShow(show.slug) %}
      {% set displayEpisodes = publishedEpisodes if publishedEpisodes.length else show.episodes %}
      {% if displayEpisodes.length %}
        <div class="podcast-show__episode-list">
          {% for episode in displayEpisodes %}
            <article class="podcast-show__episode">
              <h3><a href="{{ episode.url }}">{{ episode.title }}</a></h3>
              {% if episode.summary %}<p>{{ episode.summary }}</p>{% endif %}
              {% if episode.pageMode == "premium_teaser" %}
              <p class="podcast-premium-teaser__label">
                {{ i18n | t(language, "podcast.premiumEpisode") }}
              </p>
              <p>
                <a
                  class="btn btn-dark podcast-premium-teaser__cta"
                  href="{{ episode.subscribeUrl }}">
                  {{ i18n | t(language, "podcast.subscribeToListen") }}
                </a>
              </p>
              {% else %}
                {% set playerId = show.slug + "_" + episode.slug %}
                {% set title = episode.title %}
                {% set audioUrl = episode.audioUrl %}
                {% set downloadUrl = episode.downloadUrl or episode.audioUrl %}
                {% set artworkUrl = episode.artwork or show.artwork %}
                {% set artworkAlt = i18n | t(language, "podcast.artworkAlt", { title: episode.title }) %}
                {% set peaksUrl = episode.peaksUrl %}
                {% set playerLanguage = language %}
                {% include "snippets/audio-player.njk" %}
                <p><a href="{{ episode.url }}">{{ i18n | t(language, "podcast.episodeDetails") }}</a></p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="podcast-show__empty">
          <p class="podcast-show__empty-kicker">{{ i18n | t(language, "podcast.comingSoon") }}</p>
          <h3>{{ i18n | t(language, "podcast.episodesComing") }}</h3>
          <p>{{ i18n | t(language, "podcast.permanentHome") }}</p>
        </div>
      {% endif %}
    </div>
  </section>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  "name": {{ show.title | safeJsonLd | safe }},
  "description": {{ (show.description if language == "es" else show.descriptionEn) | safeJsonLd | safe }},
  "url": {{ (metadata.url + showPage.path) | safeJsonLd | safe }},
  "image": {{ (metadata.url + show.artwork) | safeJsonLd | safe }},
  "inLanguage": {{ show.language | safeJsonLd | safe }},
  "author": {
    "@type": "Person",
    "name": {{ show.authorName | safeJsonLd | safe }}
  },
  "genre": {{ show.category | safeJsonLd | safe }},
  "isFamilyFriendly": {{ "false" if show.explicit else "true" }},
  "publisher": {
    "@type": "Organization",
    "name": "Dust Wave",
    "url": {{ metadata.url | safeJsonLd | safe }}
  }{% if show.youtubeChannel %},
  "sameAs": [{{ show.youtubeChannel | safeJsonLd | safe }}]
  {% endif %}
}
</script>
{% if show.premium.enabled %}
<script type="module" src="/js/podcast-checkout.js?v={{ assets.version | default('dev') }}"></script>
{% endif %}
