---
layout: layouts/podcast-member.njk
disableLegacyMediaPreconnects: true
disableFontAwesome: true
disableTypekit: true
i18nRuntime: true
translationKey: podcastAccount
pagination:
  data: i18n.config.supportedLangs
  size: 1
  alias: language
permalink: "{{ i18n.config.pages.podcastAccount[language] }}"
eleventyComputed:
  title: "{{ i18n[language].podcast.member.title }}"
  description: "{{ i18n[language].podcast.member.description }}"
---

<div
  class="container podcast-member__container"
  data-podcast-member
  data-api-origin="{{ podcastMember.apiOrigin }}"
  data-turnstile-site-key="{{ podcastMember.turnstileSiteKey }}">
  <header class="podcast-member__header">
    <div>
      <p class="podcast-member__eyebrow">{{ i18n | t(language, "podcast.brand") }}</p>
      <h1>{{ i18n | t(language, "podcast.member.heading") }}</h1>
      <p>{{ i18n | t(language, "podcast.member.intro") }}</p>
    </div>
    <button
      class="btn btn-outline-light"
      type="button"
      data-podcast-member-logout
      hidden>
      {{ i18n | t(language, "podcast.member.signOut") }}
    </button>
  </header>

  <p
    class="podcast-member__status"
    data-podcast-member-global-status
    role="status"
    aria-live="polite"></p>

  <section
    class="podcast-member__panel"
    data-podcast-member-auth
    aria-labelledby="podcast-member-login-title">
    <p class="podcast-member__eyebrow">{{ i18n | t(language, "podcast.member.privateAccess") }}</p>
    <h2 id="podcast-member-login-title">{{ i18n | t(language, "podcast.member.magicLinkTitle") }}</h2>
    <p>{{ i18n | t(language, "podcast.member.magicLinkBody") }}</p>
    <form
      class="podcast-auth-turnstile-form"
      data-podcast-member-login-form>
      <label for="podcast-member-email">{{ i18n | t(language, "podcast.email") }}</label>
      <div class="podcast-member__inline-form">
        <input
          id="podcast-member-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          maxlength="254"
          required>
        <button class="btn btn-danger" type="submit">
          {{ i18n | t(language, "podcast.member.sendLink") }}
        </button>
      </div>
      {% if podcastMember.turnstileSiteKey %}
      <div
        id="podcast-member-turnstile"
        class="podcast-auth-turnstile podcast-member__turnstile"></div>
      {% endif %}
    </form>
    <p
      class="podcast-member__status"
      data-podcast-member-auth-status
      role="status"
      aria-live="polite"></p>
  </section>

  <section class="podcast-member__app" data-podcast-member-app hidden>
    <div class="podcast-member__panel">
      <p class="podcast-member__eyebrow">{{ i18n | t(language, "podcast.member.subscriptions") }}</p>
      <h2>{{ i18n | t(language, "podcast.member.library") }}</h2>
      <p data-podcast-member-session-summary></p>
      <div
        class="podcast-member__subscriptions"
        data-podcast-member-subscriptions></div>
    </div>

    <section
      class="podcast-member__panel podcast-member__redemption"
      data-podcast-pool-redemption
      aria-labelledby="podcast-pool-redemption-title"
      hidden>
      <p class="podcast-member__eyebrow">{{ i18n | t(language, "podcast.member.poolBenefit") }}</p>
      <h2 id="podcast-pool-redemption-title">{{ i18n | t(language, "podcast.member.redeemTitle") }}</h2>
      <p>{{ i18n | t(language, "podcast.member.redeemBody") }}</p>
      <form data-podcast-pool-redemption-form>
        <label for="podcast-pool-redemption-code">
          {{ i18n | t(language, "podcast.member.benefitCode") }}
        </label>
        <div class="podcast-member__inline-form">
          <input
            id="podcast-pool-redemption-code"
            name="code"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            minlength="42"
            maxlength="42"
            pattern="DW-POD-[A-HJ-NP-Z2-9]{8}(?:-[A-HJ-NP-Z2-9]{8}){3}"
            placeholder="DW-POD-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX"
            required>
          <button class="btn btn-danger" type="submit">
            {{ i18n | t(language, "podcast.member.redeem") }}
          </button>
        </div>
      </form>
      <p
        class="podcast-member__status"
        data-podcast-pool-redemption-status
        role="status"
        aria-live="polite"></p>
    </section>
  </section>

  <noscript>
    <p class="podcast-member__panel">
      {{ i18n | t(language, "podcast.member.noscript") }}
    </p>
  </noscript>
</div>
